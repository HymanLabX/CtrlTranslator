<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 全局基础排版让已打开窗口也能随令牌字典即时换色。 -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
    </Style>
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="LineHeight" Value="20.3" />
    </Style>
    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
    </Style>
    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    </Style>
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="{DynamicResource Size.BodySmall}" />
    </Style>
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5" />
    </Style>
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
    </Style>
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Margin" Value="8,4" />
    </Style>

    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ItemShell" Margin="3,2" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource Brush.Transparent}"
                            BorderBrush="{DynamicResource Brush.Transparent}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Small}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ItemShell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 按钮背景的两层覆盖以 160ms 淡入淡出，避免修改共享画笔本身。 -->
    <ControlTemplate x:Key="Button.Template" TargetType="{x:Type Button}">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="BaseBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource Radius.Small}" />
            <Border x:Name="HoverLayer" Background="{DynamicResource Brush.Hover}"
                    CornerRadius="{DynamicResource Radius.Small}" Opacity="0" />
            <Border x:Name="PressedLayer" Background="{DynamicResource Brush.Pressed}"
                    CornerRadius="{DynamicResource Radius.Small}" Opacity="0" />
            <!-- ⚠️ ContentPresenter.Resources 里这条样式不能删。
                 按钮内容是字符串时，ContentPresenter 会生成一个 TextBlock，而应用级的隐式
                 TextBlock 样式（本文件开头）会照样套到它身上、把 Foreground 写死成 Brush.Text ——
                 样式值压过继承值，于是按钮上设的任何文字颜色都不生效：
                 危险按钮的红字、向导「申请 Key」的绿字、禁用态的灰字，统统变成近黑。
                 在这里就近再给一条 TextBlock 样式，让文字颜色跟着按钮自己的 Foreground 走。 -->
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              RecognizesAccessKey="True">
                <ContentPresenter.Resources>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground"
                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Style>
                </ContentPresenter.Resources>
            </ContentPresenter>
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PressedLayer" Property="Opacity" Value="1" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="BaseBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                <Setter TargetName="BaseBorder" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                <Setter TargetName="BaseBorder" Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
                <Setter TargetName="BaseBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                <Setter TargetName="HoverLayer" Property="Opacity" Value="0" />
                <Setter TargetName="PressedLayer" Property="Opacity" Value="0" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 无底色按钮（Ghost / Icon）的模板。和上面那份只差禁用态：
         有底有框的按钮禁用时换成浅灰底，是在说「这块按不了」；
         本来就没底色的按钮照搬那套，禁用时反而凭空长出一个灰底方块 ——
         浮窗加载中的朗读 / 收藏 / 复制就是三个灰方块，比能按的时候还显眼。
         这里禁用只把整体压到 0.42 透明度，形状不变。 -->
    <ControlTemplate x:Key="Button.QuietTemplate" TargetType="{x:Type Button}">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="BaseBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource Radius.Small}" />
            <Border x:Name="HoverLayer" Background="{DynamicResource Brush.Hover}"
                    CornerRadius="{DynamicResource Radius.Small}" Opacity="0" />
            <Border x:Name="PressedLayer" Background="{DynamicResource Brush.Pressed}"
                    CornerRadius="{DynamicResource Radius.Small}" Opacity="0" />
            <!-- 同上：文字颜色跟着按钮的 Foreground 走，不被应用级 TextBlock 样式盖掉。 -->
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              RecognizesAccessKey="True">
                <ContentPresenter.Resources>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground"
                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Style>
                </ContentPresenter.Resources>
            </ContentPresenter>
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PressedLayer" Property="Opacity" Value="1" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="BaseBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                <Setter TargetName="BaseBorder" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                <Setter TargetName="HoverLayer" Property="Opacity" Value="0" />
                <Setter TargetName="PressedLayer" Property="Opacity" Value="0" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Button.PrimaryTemplate" TargetType="{x:Type Button}">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="BaseBorder" Background="{DynamicResource Brush.Primary}"
                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Small}" />
            <Border x:Name="HoverLayer" Background="{DynamicResource Brush.AccentHover}"
                    CornerRadius="{DynamicResource Radius.Small}" Opacity="0" />
            <Border x:Name="PressedLayer" Background="{DynamicResource Brush.AccentPressed}"
                    CornerRadius="{DynamicResource Radius.Small}" Opacity="0" />
            <TextBlock x:Name="PrimaryContent"
                       Text="{TemplateBinding Content}"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                       Margin="{TemplateBinding Padding}"
                       FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}"
                       FontWeight="{TemplateBinding FontWeight}"
                       Foreground="{DynamicResource Brush.OnAccent}" />
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PressedLayer" Property="Opacity" Value="0.72" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="BaseBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                <Setter TargetName="PrimaryContent" Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                <Setter TargetName="BaseBorder" Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
                <Setter TargetName="BaseBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                <Setter TargetName="HoverLayer" Property="Opacity" Value="0" />
                <Setter TargetName="PressedLayer" Property="Opacity" Value="0" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Button.Secondary" TargetType="{x:Type Button}">
        <!-- 必须是 MinHeight 而不是 Height。模板用 Margin={TemplateBinding Padding} 放内容，
             写死 Height 的话，任何自带纵向 Padding 的按钮都会把文字底部裁掉一截——
             中文尤其明显，「过」会被削成「讨」。踩过这个坑，别改回 Height。 -->
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
    </Style>
    <Style x:Key="Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="Template" Value="{StaticResource Button.PrimaryTemplate}" />
    </Style>
    <Style x:Key="Button.Ghost" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Template" Value="{StaticResource Button.QuietTemplate}" />
    </Style>
    <!-- 危险操作（清空历史这类删了就回不来的）：白底红字。
         不做红底实心 —— 那是「主操作」的分量，而清空从来不该是一页里最想让人点的那个。
         红字已经足够把它和旁边的「打开」「导出」区分开。 -->
    <Style x:Key="Button.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>
    <Style x:Key="Button.Icon" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Secondary}" />

    <ControlTemplate x:Key="TextBox.Template" TargetType="{x:Type TextBox}">
        <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource Radius.Small}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsMouseCaptureWithin" Value="True">
                <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource Brush.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.AccentSubtle}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource TextBox.Template}" />
    </Style>

    <ControlTemplate x:Key="PasswordBox.Template" TargetType="{x:Type PasswordBox}">
        <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource Radius.Small}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsMouseCaptureWithin" Value="True">
                <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource Brush.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource PasswordBox.Template}" />
    </Style>

    <ControlTemplate x:Key="ComboToggle.Template" TargetType="{x:Type ToggleButton}">
        <Border Background="{DynamicResource Brush.Transparent}">
            <Path Width="8" Height="5" Stretch="Fill" Data="M1,1 L4,4 7,1"
                  Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Border>
    </ControlTemplate>
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                                <!-- 接上 HorizontalContentAlignment：原来模板没接，
                                     外面怎么设都是左对齐，短值（如「Ctrl」）没法居中。 -->
                                <ContentPresenter x:Name="SelectionContent" Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center" IsHitTestVisible="False"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                <!-- ⚠️ MinHeight="0" 不能删。这个内嵌 TextBox 会吃到上面那条
                                     TargetType="{x:Type TextBox}" 的隐式样式，跟着拿到 MinHeight="40"；
                                     Visibility="Hidden" 的元素照样参与布局，于是不管外面把 ComboBox 的
                                     MinHeight 调到多少，下拉框都被这个隐形的 40 顶着下不来 ——
                                     表现就是"同一行里下拉框比输入框高一截"。顺手改成 Collapsed，
                                     不可编辑的下拉框连量都不用量。 -->
                                <TextBox x:Name="PART_EditableTextBox" Margin="{TemplateBinding Padding}"
                                         Background="{DynamicResource Brush.Transparent}" BorderThickness="0"
                                         Padding="0" MinHeight="0" Visibility="Collapsed"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                <ToggleButton Grid.Column="1" Focusable="False" ClickMode="Press"
                                              Template="{StaticResource ComboToggle.Template}"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="280" Margin="0,4,0,0" Padding="4"
                                    Background="{DynamicResource Brush.SurfaceRaised}"
                                    BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Medium}">
                                <ScrollViewer CanContentScroll="True"><ItemsPresenter /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 要居中就得跨过右边那 36px 的箭头列，否则内容只是在左半边居中，
                             对整个框来说是偏左的。做成触发器而不是一律跨列：
                             左对齐的下拉（服务商预设、模型名称）值可能很长，
                             跨列会让长文字压到箭头下面。 -->
                        <Trigger Property="HorizontalContentAlignment" Value="Center">
                            <Setter TargetName="SelectionContent" Property="Grid.ColumnSpan" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="SelectionContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource Brush.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Small}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Hover}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="CheckBorder" Width="18" Height="18" Background="{DynamicResource Brush.SurfaceSubtle}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="5">
                            <Path x:Name="CheckMark" Visibility="Collapsed" Data="{DynamicResource Icon.Check}"
                                  Stroke="{DynamicResource Brush.OnAccent}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Margin="3" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Brush.Pressed}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3">
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" CornerRadius="3" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Slider}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource Brush.Accent}" BorderThickness="0" Height="4">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="SliderThumb" Width="18" Height="18">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Ellipse Fill="{DynamicResource Brush.Surface}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Background="{DynamicResource Brush.Border}" BorderThickness="0" Height="4">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SliderThumb" Property="Opacity" Value="0.85" /></Trigger>
                        <Trigger Property="IsMouseCaptureWithin" Value="True"><Setter TargetName="SliderThumb" Property="Opacity" Value="0.7" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SliderThumb" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ViewportSize 必须显式 TemplateBinding。ScrollBar 只自动接 Minimum/Maximum/Value 到
         PART_Track，ViewportSize 不接；拿不到就是 NaN，Track 会退化成"滑块给个最小值"，
         于是不论内容多长，滑块都只有一小截，看着像列表边上浮了个灰点。 -->
    <ControlTemplate x:Key="ScrollBar.VerticalTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="{DynamicResource Brush.Transparent}">
            <Track x:Name="PART_Track" IsDirectionReversed="True"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" /></Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="ScrollThumb" Margin="2,0" MinHeight="28">
                        <Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}"><Border Background="{DynamicResource Brush.BorderStrong}" CornerRadius="{DynamicResource Radius.Small}" /></ControlTemplate></Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" /></Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger SourceName="ScrollThumb" Property="IsMouseOver" Value="True"><Setter TargetName="ScrollThumb" Property="Opacity" Value="1" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="ScrollBar.HorizontalTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="{DynamicResource Brush.Transparent}">
            <Track x:Name="PART_Track" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" /></Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="ScrollThumb" Margin="0,2" MinWidth="28">
                        <Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}"><Border Background="{DynamicResource Brush.BorderStrong}" CornerRadius="{DynamicResource Radius.Small}" /></ControlTemplate></Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" /></Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger SourceName="ScrollThumb" Property="IsMouseOver" Value="True"><Setter TargetName="ScrollThumb" Property="Opacity" Value="1" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- 粗细只能约束「横切」那一边：垂直条约束宽、水平条约束高。
         原来基础样式把 Width 和 Height 一起写死成 10，垂直滚动条连高度也被钉在 10px，
         于是整条轨道缩成一颗悬在列表右边的小灰点 —— 看着像渲染坏了，其实是样式写反了。 -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="10" />
        <Setter Property="Opacity" Value="0.62" />
        <Setter Property="Template" Value="{StaticResource ScrollBar.VerticalTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template" Value="{StaticResource ScrollBar.HorizontalTemplate}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
