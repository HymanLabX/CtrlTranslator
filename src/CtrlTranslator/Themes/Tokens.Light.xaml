<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- ChatGPT 风格的浅色工作台：白色画布、柔和灰层级、近黑主操作。 -->
    <Color x:Key="Color.Bg">#FFFFFF</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceRaised">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceSubtle">#F7F7F8</Color>
    <Color x:Key="Color.Border">#E5E5E5</Color>
    <Color x:Key="Color.BorderStrong">#D1D1D1</Color>
    <Color x:Key="Color.Text">#171717</Color>
    <Color x:Key="Color.TextSecondary">#5D5D5D</Color>
    <Color x:Key="Color.TextTertiary">#8F8F8F</Color>
    <Color x:Key="Color.Accent">#171717</Color>
    <Color x:Key="Color.AccentHover">#2F2F2F</Color>
    <Color x:Key="Color.AccentPressed">#000000</Color>
    <Color x:Key="Color.AccentSubtle">#ECECEC</Color>
    <Color x:Key="Color.AccentSecondary">#0D8F72</Color>
    <Color x:Key="Color.Hover">#F3F3F3</Color>
    <Color x:Key="Color.Pressed">#E8E8E8</Color>
    <Color x:Key="Color.Success">#0D8F72</Color>
    <Color x:Key="Color.SuccessBg">#E8F7F2</Color>
    <Color x:Key="Color.Warning">#9A6700</Color>
    <Color x:Key="Color.WarningBg">#FFF8E6</Color>
    <Color x:Key="Color.Danger">#D00E17</Color>
    <Color x:Key="Color.DangerBg">#FFF0F1</Color>
    <Color x:Key="Color.OnAccent">#FFFFFF</Color>
    <Color x:Key="Color.Transparent">#00FFFFFF</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="{StaticResource Color.SurfaceSubtle}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{StaticResource Color.AccentSubtle}" />
    <SolidColorBrush x:Key="Brush.AccentSecondary" Color="{StaticResource Color.AccentSecondary}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessBg" Color="{StaticResource Color.SuccessBg}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningBg" Color="{StaticResource Color.WarningBg}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerBg" Color="{StaticResource Color.DangerBg}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="{StaticResource Color.Transparent}" />

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.PrimarySubtle" Color="{StaticResource Color.AccentSubtle}" />

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <sys:Double x:Key="Size.Caption">11</sys:Double>
    <sys:Double x:Key="Size.BodySmall">12</sys:Double>
    <sys:Double x:Key="Size.Body">14</sys:Double>
    <sys:Double x:Key="Size.BodyLarge">15</sys:Double>
    <sys:Double x:Key="Size.Title">17</sys:Double>
    <sys:Double x:Key="Size.Heading">22</sys:Double>
    <sys:Double x:Key="Size.Display">30</sys:Double>
    <FontWeight x:Key="Weight.Normal">Normal</FontWeight>
    <FontWeight x:Key="Weight.Medium">Medium</FontWeight>
    <FontWeight x:Key="Weight.SemiBold">SemiBold</FontWeight>

    <sys:Double x:Key="Space.4">4</sys:Double>
    <sys:Double x:Key="Space.8">8</sys:Double>
    <sys:Double x:Key="Space.12">12</sys:Double>
    <sys:Double x:Key="Space.16">16</sys:Double>
    <sys:Double x:Key="Space.20">20</sys:Double>
    <sys:Double x:Key="Space.24">24</sys:Double>
    <sys:Double x:Key="Space.32">32</sys:Double>
    <sys:Double x:Key="Space.40">40</sys:Double>
    <sys:Double x:Key="Space.48">48</sys:Double>
    <CornerRadius x:Key="Radius.Small">8</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">10</CornerRadius>
    <CornerRadius x:Key="Radius.Large">14</CornerRadius>
    <CornerRadius x:Key="Radius.Popup">16</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <DropShadowEffect x:Key="Effect.PopupShadow"
                      BlurRadius="28" ShadowDepth="6" Direction="270"
                      Opacity="0.2" Color="#000000" />
    <DropShadowEffect x:Key="Effect.CardGlow"
                      BlurRadius="14" ShadowDepth="2" Opacity="0.12"
                      Color="#000000" />
</ResourceDictionary>
