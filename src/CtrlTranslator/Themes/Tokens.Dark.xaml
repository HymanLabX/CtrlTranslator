<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- 深浅主题的键名必须完全一致，应用才能整本替换。 -->
    <Color x:Key="Color.Bg">#16181D</Color>
    <Color x:Key="Color.Surface">#1C1F26</Color>
    <Color x:Key="Color.SurfaceSubtle">#212530</Color>
    <Color x:Key="Color.Border">#2A2E37</Color>
    <Color x:Key="Color.BorderStrong">#3A3F4B</Color>
    <Color x:Key="Color.Text">#ECEDEE</Color>
    <Color x:Key="Color.TextSecondary">#9BA1AC</Color>
    <Color x:Key="Color.TextTertiary">#6B7280</Color>
    <Color x:Key="Color.Accent">#6C93F7</Color>
    <Color x:Key="Color.AccentHover">#8AA9F9</Color>
    <Color x:Key="Color.AccentSubtle">#1E2739</Color>
    <Color x:Key="Color.Hover">#22262E</Color>
    <Color x:Key="Color.Pressed">#2A2E37</Color>
    <Color x:Key="Color.Success">#4ADE80</Color>
    <Color x:Key="Color.Warning">#FBBF24</Color>
    <Color x:Key="Color.WarningBg">#2A2415</Color>
    <Color x:Key="Color.Danger">#F87171</Color>
    <Color x:Key="Color.DangerBg">#2A1A1A</Color>
    <Color x:Key="Color.OnAccent">#FFFFFF</Color>
    <Color x:Key="Color.Transparent">#00FFFFFF</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="{StaticResource Color.SurfaceSubtle}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{StaticResource Color.AccentSubtle}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningBg" Color="{StaticResource Color.WarningBg}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerBg" Color="{StaticResource Color.DangerBg}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="{StaticResource Color.Transparent}" />

    <FontFamily x:Key="Font.Ui">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <sys:Double x:Key="Size.Caption">11</sys:Double>
    <sys:Double x:Key="Size.BodySmall">12</sys:Double>
    <sys:Double x:Key="Size.Body">13</sys:Double>
    <sys:Double x:Key="Size.BodyLarge">14</sys:Double>
    <sys:Double x:Key="Size.Title">15</sys:Double>
    <sys:Double x:Key="Size.Heading">18</sys:Double>
    <FontWeight x:Key="Weight.Normal">Normal</FontWeight>
    <FontWeight x:Key="Weight.SemiBold">SemiBold</FontWeight>

    <sys:Double x:Key="Space.4">4</sys:Double>
    <sys:Double x:Key="Space.8">8</sys:Double>
    <sys:Double x:Key="Space.12">12</sys:Double>
    <sys:Double x:Key="Space.16">16</sys:Double>
    <sys:Double x:Key="Space.20">20</sys:Double>
    <sys:Double x:Key="Space.24">24</sys:Double>
    <sys:Double x:Key="Space.32">32</sys:Double>
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">8</CornerRadius>
    <CornerRadius x:Key="Radius.Large">10</CornerRadius>

    <DropShadowEffect x:Key="Effect.PopupShadow"
                      BlurRadius="24" ShadowDepth="4" Direction="270"
                      Opacity="0.45" Color="#000000" />
</ResourceDictionary>
