<Window x:Class="CtrlTranslator.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Width="600" SizeToContent="Height"
        MinHeight="360" MaxHeight="680"
        ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        Closing="Window_OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="28,26,28,0">
            <Border DockPanel.Dock="Left" Width="42" Height="42" Margin="0,0,14,0"
                    Background="{DynamicResource Brush.AccentSubtle}"
                    CornerRadius="{DynamicResource Radius.Medium}">
                <Path Width="18" Height="18" Data="{DynamicResource Icon.Download}"
                      Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeadlineText"
                           FontFamily="{DynamicResource Font.Display}"
                           FontSize="{DynamicResource Size.Heading}" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionMetaText" Margin="0,2,0,0" TextWrapping="Wrap"
                           FontSize="{DynamicResource Size.Caption}"
                           Foreground="{DynamicResource Brush.TextTertiary}" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="28,12,28,0">
            <!-- 副标题回到正文字号。整扇窗原来除了 22px 标题就只有 12px，
                 而发布说明才是这里真正要人读的东西 —— 层级是平的。 -->
            <TextBlock x:Name="SubtitleText" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBlock Margin="0,20,0,10" Text="更新内容"
                       FontSize="{DynamicResource Size.Subheading}" FontWeight="SemiBold" />
        </StackPanel>

        <!-- 白卡叠白底（窗口底和 SurfaceRaised 都是 #FFFFFF）改成 SurfaceSubtle 填充。 -->
        <Border Grid.Row="2" MinHeight="120" MaxHeight="280" Margin="28,0" Padding="16,14"
                Background="{DynamicResource Brush.SurfaceSubtle}"
                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Medium}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Margin="28,18,28,0" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadProgressBar" Height="6" Minimum="0" Maximum="1"
                         Background="{DynamicResource Brush.SurfaceSubtle}"
                         Foreground="{DynamicResource Brush.Primary}"
                         BorderThickness="0" />
            <TextBlock x:Name="ProgressText" Margin="0,8,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="{DynamicResource Size.Caption}" />
        </StackPanel>

        <Border Grid.Row="3" Margin="28,18,28,0" Padding="14"
                Background="{DynamicResource Brush.DangerBg}"
                BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Medium}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=ErrorText}" Value="Visible">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource Brush.Danger}"
                       FontSize="{DynamicResource Size.BodySmall}" />
        </Border>

        <DockPanel Grid.Row="4" Margin="28,22,28,26">
            <Button x:Name="ReleasePageButton" DockPanel.Dock="Left"
                    Style="{StaticResource Button.Ghost}"
                    Content="打开发布页面" Click="ReleasePageButton_OnClick" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Width="112" Margin="0,0,10,0"
                        Content="稍后" Click="LaterButton_OnClick" />
                <Button x:Name="UpdateButton" Width="112"
                        Style="{StaticResource Button.Primary}"
                        Content="立即更新" Click="UpdateButton_OnClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
