<Window x:Class="CtrlTranslator.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Width="560" SizeToContent="Height"
        MinHeight="320" MaxHeight="620"
        ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        Closing="Window_OnClosing">
    <Grid Margin="24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadlineText" FontSize="{DynamicResource Size.Heading}" FontWeight="SemiBold" />

        <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="0,6,0,14" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   FontSize="{DynamicResource Size.BodySmall}" />

        <Border Grid.Row="2" MinHeight="120" MaxHeight="260" Padding="14"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Medium}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                           FontSize="{DynamicResource Size.BodySmall}" />
            </ScrollViewer>
        </Border>

        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Margin="0,16,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadProgressBar" Height="6" Minimum="0" Maximum="1"
                         Background="{DynamicResource Brush.SurfaceSubtle}"
                         Foreground="{DynamicResource Brush.Accent}"
                         BorderThickness="0" />
            <TextBlock x:Name="ProgressText" Margin="0,8,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="{DynamicResource Size.Caption}" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,16,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource Brush.Danger}"
                   FontSize="{DynamicResource Size.BodySmall}" />

        <DockPanel Grid.Row="4" Margin="0,20,0,0">
            <Button x:Name="ReleasePageButton" DockPanel.Dock="Left"
                    Style="{StaticResource Button.Ghost}" Padding="8,5"
                    Content="打开发布页面" Click="ReleasePageButton_OnClick" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Width="96" Height="32" Margin="0,0,10,0"
                        Content="稍后" Click="LaterButton_OnClick" />
                <Button x:Name="UpdateButton" Width="120" Height="32"
                        Style="{StaticResource Button.Primary}"
                        Content="立即更新" Click="UpdateButton_OnClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
