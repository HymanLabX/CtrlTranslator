<Window x:Class="CtrlTranslator.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Width="600" SizeToContent="Height"
        MinHeight="360" MaxHeight="680"
        ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        Closing="Window_OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Brush.Border}" />

        <DockPanel Grid.Row="1" Margin="28,26,28,0">
            <Border DockPanel.Dock="Left" Width="42" Height="42" Margin="0,0,14,0"
                    Background="{DynamicResource Brush.AccentSubtle}"
                    CornerRadius="{DynamicResource Radius.Medium}">
                <Path Width="18" Height="18" Data="{DynamicResource Icon.Download}"
                      Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Border>
            <TextBlock x:Name="HeadlineText" VerticalAlignment="Center"
                       FontFamily="{DynamicResource Font.Display}"
                       FontSize="{DynamicResource Size.Heading}" FontWeight="SemiBold" />
        </DockPanel>

        <TextBlock x:Name="SubtitleText" Grid.Row="2" Margin="28,10,28,18" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   FontSize="{DynamicResource Size.BodySmall}" />

        <Border Grid.Row="3" MinHeight="130" MaxHeight="280" Margin="28,0" Padding="20"
                Background="{DynamicResource Brush.SurfaceRaised}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Large}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                           FontSize="{DynamicResource Size.BodySmall}" />
            </ScrollViewer>
        </Border>

        <StackPanel x:Name="ProgressPanel" Grid.Row="4" Margin="28,18,28,0" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadProgressBar" Height="6" Minimum="0" Maximum="1"
                         Background="{DynamicResource Brush.SurfaceSubtle}"
                         Foreground="{DynamicResource Brush.Primary}"
                         BorderThickness="0" />
            <TextBlock x:Name="ProgressText" Margin="0,8,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="{DynamicResource Size.Caption}" />
        </StackPanel>

        <Border Grid.Row="4" Margin="28,18,28,0" Padding="14"
                Background="{DynamicResource Brush.DangerBg}"
                BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Medium}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=ErrorText}" Value="Visible">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource Brush.Danger}"
                       FontSize="{DynamicResource Size.BodySmall}" />
        </Border>

        <DockPanel Grid.Row="5" Margin="28,22,28,26">
            <Button x:Name="ReleasePageButton" DockPanel.Dock="Left"
                    Style="{StaticResource Button.Ghost}"
                    Content="打开发布页面" Click="ReleasePageButton_OnClick" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Width="100" Margin="0,0,10,0"
                        Content="稍后" Click="LaterButton_OnClick" />
                <Button x:Name="UpdateButton" Width="128"
                        Style="{StaticResource Button.Primary}"
                        Content="立即更新" Click="UpdateButton_OnClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
