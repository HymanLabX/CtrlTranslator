<Window x:Class="CtrlTranslator.UI.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 CtrlTranslator" Width="760" Height="640"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="DiagnosticItemTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Symbol" Text="{Binding StatusSymbol}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           FontSize="{DynamicResource Size.BodySmall}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter TargetName="Symbol" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter TargetName="Symbol" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Symbol" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock x:Name="StepText" DockPanel.Dock="Right" Foreground="{DynamicResource Brush.TextTertiary}" Text="第 1 / 4 步"/>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="CtrlTranslator 初次设置"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,24,0,18">
            <!-- 不要再给这层加固定 Width：外面 Grid 的宽度就是可用宽度，
                 写死宽度再套 Margin/Padding 会把里面那行示意图挤到裁掉两端（踩过）。 -->
            <StackPanel x:Name="WelcomePage" VerticalAlignment="Center">
                <TextBlock FontSize="28" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                           Text="选中文字，双击 Ctrl，马上翻译"/>
                <Border Margin="0,28" Padding="20,22" Background="{DynamicResource Brush.AccentSubtle}" CornerRadius="12">
                    <!-- 用 WrapPanel：窗口再窄也只会换行，不会把字切掉 -->
                    <WrapPanel HorizontalAlignment="Center">
                        <TextBlock FontSize="20" Text="选中文字" VerticalAlignment="Center"/>
                        <TextBlock Margin="14,0" FontSize="20" Text="→" VerticalAlignment="Center"/>
                        <TextBlock FontSize="20" Text="Ctrl  Ctrl" VerticalAlignment="Center"/>
                        <TextBlock Margin="14,0" FontSize="20" Text="→" VerticalAlignment="Center"/>
                        <TextBlock FontSize="20" Text="鼠标旁显示译文" VerticalAlignment="Center"/>
                    </WrapPanel>
                </Border>
                <TextBlock FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                           Text="需要一个支持 OpenAI 兼容接口的翻译服务 API Key。Key 只加密保存在这台电脑上。"/>
            </StackPanel>

            <Grid x:Name="ProviderPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="选择翻译服务商"/>
                <ListBox x:Name="ProviderList" Grid.Row="1" Margin="0,14" SelectionChanged="ProviderList_OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8" Width="640">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                                <TextBlock Grid.Column="1" Margin="10,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Description}"/>
                                <Button Grid.Column="2" Padding="7,3" Content="去申请 Key" Tag="{Binding KeyUrl}"
                                        Visibility="{Binding KeyButtonVisibility}" Click="OpenProviderWebsite_OnClick"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Padding="10" Background="{DynamicResource Brush.WarningBg}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"
                           Text="如果连接失败，请到服务商官网核对最新的接口地址和模型名。"/>
            </Grid>

            <!-- 输入控件一律用 MinHeight 而不是 Height：写死高度时，
                 内容比"高度减去内边距"高一点点就会被裁掉底部，中文字体尤其容易踩到。 -->
            <StackPanel x:Name="CredentialsPage" Visibility="Collapsed">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="填写连接信息"/>
                <TextBlock x:Name="CredentialsProviderText" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}"/>

                <TextBlock Margin="0,20,0,5" Text="API Key"/>
                <DockPanel>
                    <Button x:Name="ApplyKeyButton" DockPanel.Dock="Right" Margin="10,0,0,0" Padding="13,6"
                            Content="去申请 Key" Click="ApplyKeyButton_OnClick"/>
                    <PasswordBox x:Name="ApiKeyBox" MinHeight="34" Padding="8,7"/>
                </DockPanel>

                <TextBlock Margin="0,16,0,5" Text="模型"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="13,6" Content="拉取可用模型"
                            Click="FetchModelsButton_OnClick"/>
                    <ComboBox x:Name="ModelBox" MinHeight="34" Padding="8,6" IsEditable="True"/>
                </DockPanel>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                           FontSize="{DynamicResource Size.BodySmall}"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           Text="下拉里是这家常用的几个模型，直接选一个就行。想用别的可以手输，或点「拉取可用模型」看完整列表（要等几秒）。"/>

                <!-- 已知服务商的地址由预设决定，不让用户填 —— 填错地址是新手最常见的卡点。
                     只有「自定义」才露出可编辑的输入框。 -->
                <StackPanel x:Name="KnownBaseUrlPanel" Margin="0,16,0,0">
                    <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Brush.TextTertiary}"
                               FontSize="{DynamicResource Size.BodySmall}" Text="服务地址（已自动填好，无需修改）"/>
                    <TextBlock x:Name="BaseUrlDisplayText" TextWrapping="Wrap"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="{DynamicResource Size.BodySmall}"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>

                <StackPanel x:Name="CustomBaseUrlPanel" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Margin="0,0,0,5" Text="服务地址"/>
                    <TextBox x:Name="BaseUrlBox" MinHeight="34" Padding="8,7"/>
                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                               FontSize="{DynamicResource Size.BodySmall}"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               Text="填写任意 OpenAI 兼容接口的地址，例如 https://api.example.com/v1。"/>
                </StackPanel>

                <TextBlock x:Name="CredentialsStatusText" Margin="0,16,0,0"
                           Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid x:Name="TestPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="测试翻译服务"/>
                <Border Grid.Row="1" Margin="0,18" Padding="18" Background="{DynamicResource Brush.SurfaceSubtle}" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="测试内容：Hello, world."/>
                        <TextBlock x:Name="TestStatusText" Margin="0,12,0,0" TextWrapping="Wrap" Text="准备连接…"/>
                        <TextBlock x:Name="TestResultText" Margin="0,12,0,0" FontSize="18" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="ReadyPanel" Grid.Row="2" Visibility="Collapsed">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}"
                               TextWrapping="Wrap"
                               Text="✅ CtrlTranslator 已就绪。在任意程序里选中文字，快速双击 Ctrl 试试。"/>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="以后可以在「设置 → 服务商档案」里再加几个备用服务商。主服务商挂掉时，划词会自动改用备用，你基本察觉不到。"/>
                </StackPanel>
                <StackPanel x:Name="TestFailureActions" Grid.Row="3" Margin="0,16,0,0" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="返回修改" Padding="13,6" Click="BackFromFailureButton_OnClick"/>
                    <Button x:Name="DiagnosticsButton" Margin="10,0,0,0" Content="详细诊断" Padding="13,6"
                            Click="DiagnosticsButton_OnClick"/>
                </StackPanel>
                <ScrollViewer Grid.Row="4" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DiagnosticsList" ItemTemplate="{StaticResource DiagnosticItemTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2">
            <Button x:Name="SkipButton" Content="暂时跳过" Padding="14,7" Click="SkipButton_OnClick"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BackButton" Width="90" Margin="0,0,10,0" Content="上一步" IsEnabled="False"
                        Click="BackButton_OnClick"/>
                <Button x:Name="NextButton" Width="100" Content="下一步" Click="NextButton_OnClick"/>
                <Button x:Name="FinishButton" Width="100" Content="完成" Visibility="Collapsed" IsEnabled="False"
                        Click="FinishButton_OnClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
