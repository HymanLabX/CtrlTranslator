<Window x:Class="CtrlTranslator.UI.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 CtrlTranslator" Width="760" Height="610"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock x:Name="StepText" DockPanel.Dock="Right" Foreground="{DynamicResource Brush.TextTertiary}" Text="第 1 / 4 步"/>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="CtrlTranslator 初次设置"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,24,0,18">
            <StackPanel x:Name="WelcomePage" VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">
                <TextBlock FontSize="30" FontWeight="SemiBold" TextAlignment="Center" Text="选中文字，双击 Ctrl，马上翻译"/>
                <Border Margin="70,30" Padding="28" Background="{DynamicResource Brush.AccentSubtle}" CornerRadius="12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock FontSize="24" Text="选中文字"/>
                        <TextBlock Margin="20,0" FontSize="24" Text="→"/>
                        <TextBlock FontSize="24" Text="Ctrl  Ctrl"/>
                        <TextBlock Margin="20,0" FontSize="24" Text="→"/>
                        <TextBlock FontSize="24" Text="鼠标旁显示译文"/>
                    </StackPanel>
                </Border>
                <TextBlock FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                           Text="需要一个支持 OpenAI 兼容接口的翻译服务 API Key。Key 只加密保存在这台电脑上。"/>
            </StackPanel>

            <Grid x:Name="ProviderPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="选择翻译服务商"/>
                <ListBox x:Name="ProviderList" Grid.Row="1" Margin="0,14" SelectionChanged="ProviderList_OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8" Width="640">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                                <TextBlock Grid.Column="1" Margin="10,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Description}"/>
                                <Button Grid.Column="2" Padding="7,3" Content="去申请 Key" Tag="{Binding KeyUrl}"
                                        Visibility="{Binding KeyButtonVisibility}" Click="OpenProviderWebsite_OnClick"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Padding="10" Background="{DynamicResource Brush.WarningBg}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"
                           Text="如果连接失败，请到服务商官网核对最新的接口地址和模型名。"/>
            </Grid>

            <StackPanel x:Name="CredentialsPage" Visibility="Collapsed">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="填写连接信息"/>
                <TextBlock Margin="0,18,0,5" Text="服务地址"/>
                <TextBox x:Name="BaseUrlBox" Height="34" Padding="8,5"/>
                <TextBlock Margin="0,14,0,5" Text="API Key"/>
                <PasswordBox x:Name="ApiKeyBox" Height="34" Padding="8,5"/>
                <TextBlock Margin="0,14,0,5" Text="模型"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="13,5" Content="拉取可用模型"
                            Click="FetchModelsButton_OnClick"/>
                    <ComboBox x:Name="ModelBox" Height="34" Padding="7,4" IsEditable="True"/>
                </DockPanel>
                <TextBlock x:Name="CredentialsStatusText" Margin="0,14,0,0" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="TestPage" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="测试翻译服务"/>
                <Border Margin="0,22" Padding="18" Background="{DynamicResource Brush.SurfaceSubtle}" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="测试内容：Hello, world."/>
                        <TextBlock x:Name="TestStatusText" Margin="0,12,0,0" TextWrapping="Wrap" Text="准备连接…"/>
                        <TextBlock x:Name="TestResultText" Margin="0,12,0,0" FontSize="18" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ReadyText" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Text="✅ CtrlTranslator 已就绪。在任意程序里选中文字，快速双击 Ctrl 试试。"/>
                <StackPanel x:Name="TestFailureActions" Margin="0,16,0,0" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="返回修改" Padding="13,6" Click="BackFromFailureButton_OnClick"/>
                    <Button Margin="10,0,0,0" Content="一键诊断…" Padding="13,6" Click="DiagnosticsButton_OnClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2">
            <Button x:Name="SkipButton" Content="暂时跳过" Padding="14,7" Click="SkipButton_OnClick"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BackButton" Width="90" Margin="0,0,10,0" Content="上一步" IsEnabled="False"
                        Click="BackButton_OnClick"/>
                <Button x:Name="NextButton" Width="100" Content="下一步" Click="NextButton_OnClick"/>
                <Button x:Name="FinishButton" Width="100" Content="完成" Visibility="Collapsed" IsEnabled="False"
                        Click="FinishButton_OnClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
