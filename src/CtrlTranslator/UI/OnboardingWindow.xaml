<Window x:Class="CtrlTranslator.UI.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 CtrlTranslator" Width="760" Height="640"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}">
    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
            <Setter Property="FontSize" Value="{DynamicResource Size.Heading}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="PageCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>
        <!-- 步骤状态行。左栏本来就是竖栏，原来却只用来放一条写死满格的 3px 横条
             和一句「第 N / 4 步」—— 那条横条没有 x:Name，ShowStep 从头到尾碰不到它，
             第 1 步满格、第 4 步还是满格，是个主动给错信号的假进度条。
             换成四个有名字的步骤，沿用设置目录列的选中语言（白色抬起 + 绿色左条 + 半粗）。 -->
        <DataTemplate x:Key="StepItemTemplate">
            <Border x:Name="Shell" MinHeight="34" Margin="0,0,0,3"
                    Background="{DynamicResource Brush.Transparent}"
                    BorderBrush="{DynamicResource Brush.Transparent}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Small}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="AccentBar" Margin="0,7" CornerRadius="0,2,2,0"
                            Background="{DynamicResource Brush.Transparent}" />
                    <Path x:Name="Marker" Grid.Column="1" Margin="9,0,0,0"
                          Width="15" Height="15" VerticalAlignment="Center" Stretch="Uniform"
                          Data="{DynamicResource Icon.Circle}"
                          Stroke="{DynamicResource Brush.BorderStrong}"
                          Fill="{DynamicResource Brush.Transparent}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <TextBlock x:Name="Label" Grid.Column="2" Margin="6,0,10,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               Text="{Binding Name}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="done">
                    <Setter TargetName="Marker" Property="Data" Value="{DynamicResource Icon.Check}" />
                    <Setter TargetName="Marker" Property="Stroke" Value="{DynamicResource Brush.Success}" />
                    <Setter TargetName="Marker" Property="StrokeThickness" Value="1.8" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="current">
                    <Setter TargetName="Marker" Property="Data" Value="{DynamicResource Icon.Dot}" />
                    <Setter TargetName="Marker" Property="Stroke" Value="{DynamicResource Brush.Text}" />
                    <Setter TargetName="Marker" Property="Fill" Value="{DynamicResource Brush.Text}" />
                    <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Surface}" />
                    <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                    <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Brush.AccentSecondary}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 服务商卡片。原来是个原生 ListBox 加边框，可同样这八个服务商，
             用户在「设置 → 翻译模型」里看到的是卡片 —— 同一批东西两副面孔。
             这里跟档案卡对齐：等分列、绿色左条表示选中。 -->
        <Style x:Key="ProviderCard" TargetType="ListBoxItem">
            <Setter Property="Height" Value="68" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Shell" Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Medium}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar" Margin="0,10" CornerRadius="0,2,2,0"
                                        Background="{DynamicResource Brush.Transparent}" />
                                <ContentPresenter Grid.Column="1" Margin="11,0,13,0"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Brush.AccentSecondary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProviderCardTemplate">
            <StackPanel>
                <DockPanel>
                    <!-- 「申请 Key」做成弱化的文字按钮：它是卡片里的次要动作，
                         不该长得跟页脚那些实心按钮一样重。 -->
                    <Button DockPanel.Dock="Right" Margin="8,0,-6,0" MinHeight="22" Padding="6,0"
                            Style="{StaticResource Button.Ghost}"
                            FontSize="{DynamicResource Size.BodySmall}"
                            Foreground="{DynamicResource Brush.AccentSecondary}"
                            Content="{Binding KeyLinkText}" Tag="{Binding KeyUrl}"
                            Visibility="{Binding KeyButtonVisibility}"
                            Click="OpenProviderWebsite_OnClick" />
                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Text="{Binding Name}" />
                </DockPanel>
                <TextBlock Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource Size.BodySmall}"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           Text="{Binding Description}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DiagnosticItemTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path x:Name="StatusIcon" Width="15" Height="15" VerticalAlignment="Center"
                      Stretch="Uniform" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           FontSize="{DynamicResource Size.BodySmall}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter TargetName="StatusIcon" Property="Data" Value="{DynamicResource Icon.Check}" />
                    <Setter TargetName="StatusIcon" Property="Stroke" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter TargetName="StatusIcon" Property="Data" Value="{DynamicResource Icon.Warning}" />
                    <Setter TargetName="StatusIcon" Property="Stroke" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="StatusIcon" Property="Data" Value="{DynamicResource Icon.Error}" />
                    <Setter TargetName="StatusIcon" Property="Stroke" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 一级导航的那套底色和分界：NavPrimary + BorderStrong。
             原来是 SurfaceSubtle + Border，和右边纯白内容区差得太少，肉眼分不出两块区域 ——
             主窗口侧栏当初就是因为这个才换的，引导窗只是没跟着改。 -->
        <Border Background="{DynamicResource Brush.NavPrimary}"
                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="0,0,1,0"
                Padding="10,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 左边距 12 = 3px 选中条 + 9px 间距，让品牌图标和下面的步骤图标落在同一条左边线上。 -->
                <StackPanel Margin="12,0,10,20">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="24" Height="24" VerticalAlignment="Center"
                               Source="pack://application:,,,/Assets/ctrltranslator.ico"
                               AutomationProperties.Name="CtrlTranslator 程序图标" />
                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Display}"
                                   FontSize="{DynamicResource Size.BodyLarge}"
                                   FontWeight="SemiBold" Text="CtrlTranslator" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="StepText" Grid.Row="1" Margin="12,0,10,8"
                           FontSize="{DynamicResource Size.Caption}"
                           Foreground="{DynamicResource Brush.TextTertiary}" Text="第 1 / 4 步" />

                <ItemsControl x:Name="StepList" Grid.Row="2"
                              ItemTemplate="{StaticResource StepItemTemplate}" />

                <TextBlock Grid.Row="3" Margin="12,0,10,0"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           FontSize="{DynamicResource Size.Caption}" TextWrapping="Wrap"
                           Text="API Key 使用 Windows 账户加密，仅保存在本机。" />
            </Grid>
        </Border>

        <!-- 原来这里顶着一个 12px 绿色半粗的「初次设置」小眉标，压在 30px 大标题上方。
             那是西文的「小写灰色眉标」写法，靠大写加字距立得住；中文没有大小写，学不来。
             何况左栏已经说清楚你在初次设置里了。 -->
        <Grid Grid.Column="1" Margin="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
                <StackPanel x:Name="WelcomePage" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" FontSize="{DynamicResource Size.Display}"
                               TextWrapping="Wrap" Text="选中，双击，立刻读懂" />
                    <TextBlock Style="{StaticResource PageCaption}"
                               Text="CtrlTranslator 在鼠标旁直接呈现译文，不切换窗口，也不打断你的阅读节奏。" />
                    <!-- 窗口底和 SurfaceRaised 都是 #FFFFFF，白卡叠白底只剩两圈边框在撑结构 ——
                         设置页当初就是这个毛病。改成 SurfaceSubtle 填充，里面的数字块反过来用白底描边。 -->
                    <Border Padding="20" Background="{DynamicResource Brush.SurfaceSubtle}"
                            BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Large}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Small}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" Text="01" />
                                </Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="在任意程序中选中文字" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Small}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" Text="02" />
                                </Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="快速双击 Ctrl 键" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Small}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" Text="03" />
                                </Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="在鼠标旁查看译文" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid x:Name="ProviderPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="选择翻译服务商" />
                        <TextBlock Style="{StaticResource PageCaption}" Margin="0,0,0,8"
                                   Text="选一家你已经有 API Key 的服务商。以后还能在设置里再添加别的模型当备用。" />
                    </StackPanel>
                    <ListBox x:Name="ProviderList" Grid.Row="1" Margin="0,10,-10,10"
                             BorderThickness="0" Padding="0"
                             Background="{DynamicResource Brush.Transparent}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ProviderCard}"
                             ItemTemplate="{StaticResource ProviderCardTemplate}"
                             SelectionChanged="ProviderList_OnSelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <Border Grid.Row="2" Padding="12" Background="{DynamicResource Brush.WarningBg}"
                            BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Medium}">
                        <TextBlock Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"
                                   Text="如果连接失败，请到服务商官网核对最新的接口地址和模型名。" />
                    </Border>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Visibility, ElementName=CredentialsPage}">
                    <StackPanel x:Name="CredentialsPage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="填写连接信息" />
                        <TextBlock x:Name="CredentialsProviderText" Style="{StaticResource PageCaption}" />

                        <!-- 「自定义」时服务地址排第一：地址决定了 Key 去哪儿申请、模型名怎么写，
                             原来排在 Key 和模型后面，用户得先填两项再回头才发现最关键的还空着。
                             已知服务商的地址是只读展示，仍然放在最后当参考。 -->
                        <StackPanel x:Name="CustomBaseUrlPanel" Margin="0,0,0,18" Visibility="Collapsed">
                            <TextBlock Margin="0,0,0,6" Text="服务地址" />
                            <TextBox x:Name="BaseUrlBox" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                       FontSize="{DynamicResource Size.BodySmall}"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       Text="填写 OpenAI 兼容接口地址，例如 https://api.example.com/v1。" />
                        </StackPanel>

                        <TextBlock x:Name="ApiKeyLabel" Margin="0,0,0,6" Text="API Key" />
                        <DockPanel>
                            <Button x:Name="ApplyKeyButton" DockPanel.Dock="Right" Margin="10,0,0,0"
                                    Content="去申请 Key" Click="ApplyKeyButton_OnClick" />
                            <PasswordBox x:Name="ApiKeyBox" />
                        </DockPanel>

                        <TextBlock Margin="0,18,0,6" Text="模型" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="拉取可用模型"
                                    Click="FetchModelsButton_OnClick" />
                            <ComboBox x:Name="ModelBox" IsEditable="True" />
                        </DockPanel>
                        <TextBlock Margin="0,7,0,0" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Size.BodySmall}"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   Text="可直接选择常用模型，也可以手动输入；拉取完整列表可能需要几秒。" />

                        <StackPanel x:Name="KnownBaseUrlPanel" Margin="0,18,0,0">
                            <TextBlock Margin="0,0,0,5" Foreground="{DynamicResource Brush.TextTertiary}"
                                       FontSize="{DynamicResource Size.BodySmall}" Text="服务地址（已自动配置）" />
                            <Border Padding="12,9" Background="{DynamicResource Brush.SurfaceSubtle}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Small}">
                                <TextBlock x:Name="BaseUrlDisplayText" TextWrapping="Wrap"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Size.BodySmall}"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="CredentialsStatusText" Margin="0,16,0,0"
                                   Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="TestPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="测试翻译服务" />
                        <TextBlock Style="{StaticResource PageCaption}" Margin="0,0,0,4"
                                   Text="我们会发送一句测试文本，确认鉴权、模型和翻译链路正常。" />
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="18"
                            Background="{DynamicResource Brush.SurfaceRaised}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Large}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="测试内容：Hello, world." />
                            <TextBlock x:Name="TestStatusText" Margin="0,12,0,0" TextWrapping="Wrap" Text="准备连接…" />
                            <TextBlock x:Name="TestResultText" Margin="0,12,0,0"
                                       FontSize="{DynamicResource Size.Title}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="ReadyPanel" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0"
                                    Background="{DynamicResource Brush.SuccessBg}" CornerRadius="14">
                                <Path Width="14" Height="14" Data="{DynamicResource Icon.Check}"
                                      Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Size.Title}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}"
                                       TextWrapping="Wrap" Text="CtrlTranslator 已就绪" />
                        </DockPanel>
                        <TextBlock Margin="38,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="在任意程序里选中文字，快速双击 Ctrl 试试。想加备用模型，以后到「应用设置 → 翻译模型」里添加。" />
                    </StackPanel>
                    <StackPanel x:Name="TestFailureActions" Grid.Row="3" Margin="0,16,0,0"
                                Orientation="Horizontal" Visibility="Collapsed">
                        <Button Content="返回修改" Click="BackFromFailureButton_OnClick" />
                        <Button x:Name="DiagnosticsButton" Margin="10,0,0,0" Content="详细诊断"
                                Click="DiagnosticsButton_OnClick" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="4" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DiagnosticsList" ItemTemplate="{StaticResource DiagnosticItemTemplate}" />
                    </ScrollViewer>
                </Grid>
            </Grid>

            <DockPanel Grid.Row="1">
                <Button x:Name="SkipButton" Style="{StaticResource Button.Ghost}"
                        Content="暂时跳过" Click="SkipButton_OnClick" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BackButton" Width="112" Margin="0,0,10,0"
                            Content="上一步" IsEnabled="False" Click="BackButton_OnClick" />
                    <Button x:Name="NextButton" Width="112" Style="{StaticResource Button.Primary}"
                            Content="下一步" Click="NextButton_OnClick" />
                    <Button x:Name="FinishButton" Width="112" Style="{StaticResource Button.Primary}"
                            Content="完成" Visibility="Collapsed" IsEnabled="False"
                            Click="FinishButton_OnClick" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
