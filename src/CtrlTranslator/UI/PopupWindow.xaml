<Window x:Class="CtrlTranslator.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻译结果"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        SizeToContent="Height"
        Opacity="0">
    <Window.Resources>
        <!-- 窗口控制（钉住 / 关闭）：比左下角那三个内容操作更轻。
             默认用最淡的三级文字色，悬停才变实并浮出底色 —— 它们是配角，
             不该和"朗读 / 收藏 / 复制"抢同样的注意力。钉住态给足底色和实心，
             因为"钉住了没有"必须一眼看得出来，光靠描边颜色太弱。 -->
        <Style x:Key="WindowControl" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 提示条里的按钮：颜色跟着提示条走（黄条黄字、红条红字）。
             提示条不参与浮窗换肤（深色配色下仍是浅底一小块），按钮要是用普通次要按钮，
             深色配色下就是浅色条上嵌一块深色按钮。所以底色、描边、悬停全从 Foreground 推出来，
             Foreground 由代码按提示种类设成 Brush.Warning / Brush.Danger。
             BorderThickness="0" 就是不带描边的文字按钮（「不再提示」这类次要动作）。 -->
        <Style x:Key="NoticeButton" TargetType="Button">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
            <Setter Property="FontSize" Value="{DynamicResource Size.BodySmall}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Outline" CornerRadius="{DynamicResource Radius.Small}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding Foreground}" Opacity="0.45" />
                            <Border x:Name="Fill" CornerRadius="{DynamicResource Radius.Small}"
                                    Background="{TemplateBinding Foreground}" Opacity="0" />
                            <!-- 文字颜色必须就近再给一条样式，否则应用级 TextBlock 样式会把它压成近黑（见 Controls.xaml）。 -->
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground"
                                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.08" />
                                <Setter TargetName="Outline" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.16" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outline" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupIconPath" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="{DynamicResource Brush.Transparent}" />
        </Style>
        <DataTemplate x:Key="IconTemplate.Speech">
            <Path x:Name="Icon" Style="{StaticResource PopupIconPath}" Data="{DynamicResource Icon.Speaker}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="stop">
                    <Setter TargetName="Icon" Property="Data" Value="{DynamicResource Icon.Stop}" />
                    <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="IconTemplate.Star">
            <Path x:Name="Icon" Style="{StaticResource PopupIconPath}" Data="{DynamicResource Icon.Star}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="star-filled">
                    <Setter TargetName="Icon" Property="Data" Value="{DynamicResource Icon.StarFilled}" />
                    <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="IconTemplate.Copy">
            <Path x:Name="Icon" Style="{StaticResource PopupIconPath}" Data="{DynamicResource Icon.Copy}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="copied">
                    <Setter TargetName="Icon" Property="Data" Value="{DynamicResource Icon.Check}" />
                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="IconTemplate.Pin">
            <Border x:Name="Chip" CornerRadius="{DynamicResource Radius.Small}"
                    Background="{DynamicResource Brush.Transparent}" Padding="4">
                <Path x:Name="Icon" Style="{StaticResource PopupIconPath}"
                      Width="14" Height="14" Data="{DynamicResource Icon.Pin}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="pinned">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="IconTemplate.Close">
            <Path Style="{StaticResource PopupIconPath}" Width="13" Height="13"
                  Data="{DynamicResource Icon.Close}" />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="ShellBorder"
            Background="{DynamicResource Brush.SurfaceRaised}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            CornerRadius="{DynamicResource Radius.Popup}"
            BorderThickness="1"
            Padding="14,10,14,8"
            Effect="{DynamicResource Effect.PopupShadow}"
            MouseLeftButtonDown="Shell_OnMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!-- ⚠️ 内容行必须是 *，不能是 Auto。SizeToContent="Height" 撞上 MaxHeight 之后，
                     Auto 行会按内容的完整高度去要空间，把下面那行操作栏整个顶出可视区
                     （长译文时底部按钮和元信息直接看不见了）。给 * 之后它只拿剩余空间，
                     超出的部分由自己的滚动条消化。 -->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶行：原文回显 + 窗口控制。
                 拖动挂在整个外壳上（见 Shell_OnMouseLeftButtonDown），不再只有这一条 26px
                 的窄带可拖 —— 那条太细，稍微瞄低一点就落到内容区，表现就是"拖了没反应"。
                 原文那行放在这里，是因为划词经常划多、划少或划错 —— 译文出来读着不对时，
                 用户没法判断是模型翻错了还是自己选错了，只能关掉重划。 -->
            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SourceEchoText" VerticalAlignment="Center"
                           Margin="0,0,8,0" TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource Size.BodySmall}"
                           Foreground="{DynamicResource Brush.TextTertiary}" />
                <Button x:Name="PinButton" Grid.Column="1" Style="{StaticResource WindowControl}"
                        AutomationProperties.Name="钉住浮窗"
                        Content="pin" ContentTemplate="{StaticResource IconTemplate.Pin}"
                        ToolTip="钉住（点开后浮窗不会因为点别处而关闭）" Click="PinButton_OnClick" />
                <Button Grid.Column="2" Margin="1,0,0,0" Style="{StaticResource WindowControl}"
                        AutomationProperties.Name="关闭浮窗"
                        Content="close" ContentTemplate="{StaticResource IconTemplate.Close}"
                        ToolTip="关闭" Click="CloseButton_OnClick" />
            </Grid>

            <!-- 提示条：上面一段话、下面一排按钮。
                 原来按钮和文字挤在同一行，三个按钮把文字压成四行窄条、按钮又被撑得老高，
                 读的人得在一堆按钮缝里找字。现在文字整行铺开，按钮排在它下面。
                 报错也走这一条（红色）：以前是红条里一句「可以尝试下面的修复操作」、
                 正文里再红一遍真正的原因，同一件事说两次，真正的原因反而离按钮最远。 -->
            <Border x:Name="NoticeBorder" Grid.Row="1" Margin="0,10,0,0" Padding="10,8,10,9"
                    CornerRadius="{DynamicResource Radius.Small}" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <Path x:Name="NoticeIcon" DockPanel.Dock="Left" Width="14" Height="14"
                              Margin="0,2,8,0" VerticalAlignment="Top" Stretch="Uniform"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" LineHeight="19"
                                   FontSize="{DynamicResource Size.BodySmall}" />
                    </DockPanel>
                    <!-- 左边距 22 = 图标 14 + 间距 8：按钮和文字左对齐，不和图标对齐。 -->
                    <WrapPanel x:Name="NoticeActions" Margin="22,8,0,0" Orientation="Horizontal">
                        <Button x:Name="DisableThinkingButton" Margin="0,0,6,0"
                                Style="{StaticResource NoticeButton}"
                                Content="关闭思考模式" Visibility="Collapsed"
                                Click="DisableThinkingButton_OnClick" />
                        <Button x:Name="NoticeActionButton" Margin="0,0,6,0"
                                Style="{StaticResource NoticeButton}"
                                Click="NoticeActionButton_OnClick" />
                        <Button x:Name="NoticeDismissButton"
                                Style="{StaticResource NoticeButton}" BorderThickness="0"
                                Content="关闭提示" Visibility="Collapsed"
                                Click="NoticeDismissButton_OnClick" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <StackPanel x:Name="LoadingPanel" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4">
                    <Viewbox Width="15" Height="15" Margin="0,0,10,0">
                        <Path Data="M8,1.25 A6.75,6.75 0 1 1 3.23,3.23"
                              Stroke="{DynamicResource Brush.Primary}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                             From="0" To="360" Duration="0:0:0.8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Viewbox>
                    <TextBlock x:Name="LoadingText" VerticalAlignment="Center"
                               FontSize="{DynamicResource Size.BodySmall}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="翻译中… 0.0 秒" />
                </StackPanel>
                <FlowDocumentScrollViewer x:Name="ContentViewer"
                                          Visibility="Collapsed"
                                          Background="{DynamicResource Brush.Transparent}"
                                          Foreground="{DynamicResource Brush.Text}"
                                          BorderThickness="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsToolBarVisible="False" />
            </Grid>

            <!-- 降级 / 直连说明挪到译文下面：它是「这次是怎么翻出来的」的旁注，
                 和底部那行「模型 · 耗时」是一类信息。放在译文上面时，
                 读的人每次都要先跳过一行和译文无关的话。 -->
            <TextBlock x:Name="FallbackNoticeText" Grid.Row="3" Margin="0,8,0,0"
                       Visibility="Collapsed" TextWrapping="Wrap"
                       FontSize="{DynamicResource Size.Caption}"
                       Foreground="{DynamicResource Brush.TextTertiary}" />

            <!-- 底部：对内容的操作 + 这次是谁翻的。
                 朗读 / 收藏 / 复制 从顶部挪下来 —— 它们是对译文的操作，该跟着内容走；
                 顶部只留钉住和关闭这两个真正的窗口控制，第一眼落点才是原文和译文。 -->
            <Grid x:Name="ActionRow" Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SpeechButton" Width="24" Height="24" MinHeight="24"
                            Style="{StaticResource Button.Icon}"
                            AutomationProperties.Name="朗读原文"
                            Content="speech" ContentTemplate="{StaticResource IconTemplate.Speech}"
                            ToolTip="朗读原文" Click="SpeechButton_OnClick" />
                    <Button x:Name="StarButton" Width="24" Height="24" MinHeight="24" Margin="2,0,0,0"
                            Style="{StaticResource Button.Icon}"
                            AutomationProperties.Name="收藏翻译"
                            Content="star" ContentTemplate="{StaticResource IconTemplate.Star}"
                            ToolTip="收藏" Click="StarButton_OnClick" />
                    <Button x:Name="CopyButton" Width="24" Height="24" MinHeight="24" Margin="2,0,0,0"
                            Style="{StaticResource Button.Icon}"
                            AutomationProperties.Name="复制译文"
                            Content="copy" ContentTemplate="{StaticResource IconTemplate.Copy}"
                            ToolTip="复制译文" Click="CopyButton_OnClick" />
                </StackPanel>
                <TextBlock x:Name="MetaText" Grid.Column="1" Margin="10,0,0,0"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource Size.Caption}"
                           Foreground="{DynamicResource Brush.TextTertiary}" />
            </Grid>
        </Grid>
    </Border>
</Window>
