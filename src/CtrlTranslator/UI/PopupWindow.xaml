<Window x:Class="CtrlTranslator.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻译结果"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        SizeToContent="Height">
    <Border x:Name="ShellBorder"
            CornerRadius="8"
            BorderThickness="1"
            Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.24" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="Toolbar" Grid.Row="0" MouseLeftButtonDown="Toolbar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SpeechButton" Grid.Column="0" Width="28" Height="24"
                        Content="🔊" IsEnabled="False" ToolTip="朗读原文将在 M4 提供" />
                <Button x:Name="StarButton" Grid.Column="1" Width="28" Height="24" Margin="4,0,0,0"
                        Content="☆" ToolTip="收藏" Click="StarButton_OnClick" />
                <Button x:Name="CopyButton" Grid.Column="2" Width="56" Height="24" Margin="4,0,0,0"
                        Content="📋" ToolTip="复制译文" Click="CopyButton_OnClick" />
                <Button x:Name="PinButton" Grid.Column="4" Width="28" Height="24"
                        Content="📌" ToolTip="钉住" Click="PinButton_OnClick" />
                <Button Grid.Column="5" Width="28" Height="24" Margin="4,0,0,0"
                        Content="✕" ToolTip="关闭" Click="CloseButton_OnClick" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" Margin="8">
                    <ProgressBar Width="160" Height="4" IsIndeterminate="True" />
                    <TextBlock x:Name="LoadingText" Margin="0,8,0,0"
                               HorizontalAlignment="Center" Text="翻译中…（已等待 0.0 秒）" />
                </StackPanel>
                <FlowDocumentScrollViewer x:Name="ContentViewer"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsToolBarVisible="False" />
            </Grid>

            <Border x:Name="NoticeBorder" Grid.Row="2" Margin="0,8,0,0" Padding="8"
                    CornerRadius="5" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="DisableThinkingButton" Padding="8,2" Margin="0,0,4,0"
                                Content="关闭思考模式" Visibility="Collapsed"
                                Click="DisableThinkingButton_OnClick" />
                        <Button x:Name="NoticeActionButton" Padding="8,2" Margin="0,0,4,0"
                                Click="NoticeActionButton_OnClick" />
                        <Button x:Name="NoticeDismissButton" Padding="8,2" Content="关闭提示"
                                Visibility="Collapsed" Click="NoticeDismissButton_OnClick" />
                    </StackPanel>
                    <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
