<Window x:Class="CtrlTranslator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CtrlTranslator.UI"
        Title="CtrlTranslator 翻译历史" Width="1120" Height="720"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource Brush.Bg}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ui:SingleLineConverter x:Key="SingleLine" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SideNavToggle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shell" Margin="0,2" Padding="13,10"
                                Background="{DynamicResource Brush.Transparent}"
                                BorderBrush="{DynamicResource Brush.Transparent}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Medium}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSubNavItem" TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="{DynamicResource Size.BodySmall}" />
        </Style>

        <Style x:Key="HistoryItem" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="66" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Shell" Background="{DynamicResource Brush.Transparent}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar" Background="{DynamicResource Brush.Transparent}" />
                                <ContentPresenter Grid.Column="1" Margin="16,13" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HistoryItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SourceText, Converter={StaticResource SingleLine}}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource Size.Body}"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="{Binding ResultText, Converter={StaticResource SingleLine}}"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource Size.BodySmall}"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ModeId}" FontSize="{DynamicResource Size.Caption}"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                        <Path Margin="7,0,0,0" Width="12" Height="12" Stretch="Uniform"
                              VerticalAlignment="Center" Data="{DynamicResource Icon.StarFilled}"
                              Fill="{DynamicResource Brush.Text}" Stroke="{DynamicResource Brush.Text}"
                              Visibility="{Binding Starred, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                               Margin="0,4,0,0" HorizontalAlignment="Right"
                               FontSize="{DynamicResource Size.Caption}"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Brush.SurfaceSubtle}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0"
                Padding="16,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="8,2,8,26" Orientation="Horizontal">
                    <Image Width="34" Height="34" VerticalAlignment="Center"
                           Source="pack://application:,,,/Assets/ctrltranslator.ico"
                           AutomationProperties.Name="CtrlTranslator 程序图标" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.Display}"
                               FontSize="{DynamicResource Size.Title}" FontWeight="SemiBold"
                               Text="CtrlTranslator" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="AllTabButton" Style="{StaticResource SideNavToggle}"
                                 GroupName="PrimaryNavigation"
                                 IsChecked="True" Checked="HistoryTab_OnChecked">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Width="17" Height="17" Stretch="Uniform" Data="{DynamicResource Icon.History}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="翻译历史"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="StarredTabButton" Style="{StaticResource SideNavToggle}"
                                 GroupName="PrimaryNavigation"
                                 Checked="HistoryTab_OnChecked">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Width="17" Height="17" Stretch="Uniform" Data="{DynamicResource Icon.Star}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="我的收藏"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="SettingsTabButton" Style="{StaticResource SideNavToggle}"
                                 GroupName="PrimaryNavigation" Checked="SettingsTab_OnChecked">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Width="17" Height="17" Stretch="Uniform" Data="{DynamicResource Icon.Settings}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="设置"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </Grid>
                    </RadioButton>
                    <ListBox x:Name="SettingsSectionNav" Margin="14,4,0,8"
                             BorderThickness="0" Background="{DynamicResource Brush.Transparent}"
                             ItemContainerStyle="{StaticResource SettingsSubNavItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="Collapsed" SelectedIndex="0"
                             SelectionChanged="SettingsSectionNav_OnSelectionChanged">
                        <ListBoxItem Content="服务商档案" />
                        <ListBoxItem Content="模型参数" />
                        <ListBoxItem Content="翻译行为" />
                        <ListBoxItem Content="触发方式" />
                        <ListBoxItem Content="隐私与安全" />
                        <ListBoxItem Content="系统" />
                    </ListBox>
                </StackPanel>

                <DockPanel Grid.Row="3" Margin="8,0">
                    <Border DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0"
                            Background="{DynamicResource Brush.SuccessBg}" CornerRadius="9">
                        <Path Width="10" Height="10" Data="{DynamicResource Icon.Check}"
                              Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Size.BodySmall}"
                               Foreground="{DynamicResource Brush.TextSecondary}" Text="已就绪" />
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
        <Grid x:Name="HistoryContent" Margin="34,28,34,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock FontFamily="{DynamicResource Font.Display}"
                           FontSize="{DynamicResource Size.Heading}" FontWeight="SemiBold"
                           Text="翻译工作台" />
                <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource Size.Body}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           Text="查找、回顾并整理你的翻译记录" />
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,22">
                <Button DockPanel.Dock="Right" Margin="14,0,0,0"
                        Style="{StaticResource Button.Secondary}"
                        Content="导出 CSV" Click="ExportButton_OnClick" />
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="40,8,12,8"
                             AutomationProperties.Name="搜索翻译历史"
                             TextChanged="SearchBox_OnTextChanged" />
                    <Path Width="16" Height="16" Margin="14,0,0,0" Stretch="Uniform"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          IsHitTestVisible="False" Data="{DynamicResource Icon.Search}"
                          Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <TextBlock Margin="41,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource Brush.TextTertiary}" Text="搜索原文或译文">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="52*" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Large}"
                        Background="{DynamicResource Brush.Surface}">
                    <Grid>
                        <ListBox x:Name="HistoryGrid" BorderThickness="0" Background="{DynamicResource Brush.Transparent}"
                                 ItemContainerStyle="{StaticResource HistoryItem}"
                                 ItemTemplate="{StaticResource HistoryItemTemplate}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="HistoryGrid_OnSelectionChanged"
                                 ScrollViewer.ScrollChanged="HistoryGrid_OnScrollChanged">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="复制原文" Click="CopySource_OnClick" />
                                    <MenuItem Header="复制译文" Click="CopyResult_OnClick" />
                                    <Separator />
                                    <MenuItem x:Name="StarMenuItem" Header="收藏 / 取消收藏" Click="ToggleStar_OnClick" />
                                    <MenuItem Header="删除这条记录" Click="DeleteRecord_OnClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <TextBlock x:Name="EmptyStateText" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="28" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Large}"
                            Background="{DynamicResource Brush.Surface}" Padding="20,18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}"
                                        AutomationProperties.Name="复制原文"
                                        ToolTip="复制原文" Click="CopySource_OnClick">
                                    <Path Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource Icon.Copy}"
                                          Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Button>
                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="原文" />
                            </DockPanel>
                            <TextBox x:Name="SourceDetail" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True"
                                     BorderThickness="0" Background="{DynamicResource Brush.Transparent}" Padding="0"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Large}"
                            Background="{DynamicResource Brush.Surface}" Padding="20,18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}"
                                        AutomationProperties.Name="复制译文"
                                        ToolTip="复制译文" Click="CopyResult_OnClick">
                                    <Path Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource Icon.Copy}"
                                          Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Button>
                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="译文" />
                            </DockPanel>
                            <TextBox x:Name="ResultDetail" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True"
                                     BorderThickness="0" Background="{DynamicResource Brush.Transparent}" Padding="0"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="MetadataText" Grid.Row="3" Margin="2,10,0,0" TextWrapping="Wrap"
                               FontSize="{DynamicResource Size.Caption}"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                </Grid>
            </Grid>
        </Grid>

        <ContentControl x:Name="SettingsHost" Visibility="Collapsed"
                        KeyboardNavigation.TabNavigation="Local" />
        </Grid>
    </Grid>
</Window>
