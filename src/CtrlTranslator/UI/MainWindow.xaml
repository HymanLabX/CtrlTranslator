<Window x:Class="CtrlTranslator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CtrlTranslator.UI"
        Title="CtrlTranslator" Width="1120" Height="720"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource Brush.SurfaceSubtle}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ui:SingleLineConverter x:Key="SingleLine" />

        <Style x:Key="SideNavToggle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shell" Margin="0,2" Padding="13,10"
                                Background="{DynamicResource Brush.Transparent}"
                                BorderBrush="{DynamicResource Brush.Transparent}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Medium}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContentFilterToggle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shell" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource Brush.Transparent}"
                                BorderBrush="{DynamicResource Brush.Transparent}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryItem" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Shell" Background="{DynamicResource Brush.Transparent}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar" Background="{DynamicResource Brush.Transparent}" />
                                <ContentPresenter Grid.Column="1" Margin="16,10,10,10" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HistoryItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SourceText, Converter={StaticResource SingleLine}}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource Size.Body}"
                           Foreground="{DynamicResource Brush.Text}" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Width="36" Height="36" Padding="0" Style="{StaticResource Button.Icon}"
                            AutomationProperties.Name="切换收藏状态"
                            ToolTip="收藏 / 取消收藏" Click="ToggleStar_OnClick">
                        <Path Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource Icon.Star}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{DynamicResource Brush.TextSecondary}" />
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Transparent}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Starred}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Brush.Text}" />
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Text}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Width="36" Height="36" Padding="0" Margin="4,0,0,0"
                            Style="{StaticResource Button.Icon}"
                            AutomationProperties.Name="删除这条记录"
                            ToolTip="删除这条记录" Click="DeleteRecord_OnClick">
                        <Path Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource Icon.Trash}"
                              Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource Brush.SurfaceSubtle}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Panel.ZIndex="1" Background="{DynamicResource Brush.Hover}"
                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="0,0,1,0"
                Padding="16,22">
            <Border.Effect>
                <StaticResource ResourceKey="Effect.SidebarShadow" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="8,2,8,26" Orientation="Horizontal">
                    <Image Width="34" Height="34" VerticalAlignment="Center"
                           Source="pack://application:,,,/Assets/ctrltranslator.ico"
                           AutomationProperties.Name="CtrlTranslator 程序图标" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.Display}"
                               FontSize="{DynamicResource Size.Title}" FontWeight="SemiBold"
                               Text="CtrlTranslator" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="SettingsTabButton" Style="{StaticResource SideNavToggle}"
                                 GroupName="PrimaryNavigation" Checked="SettingsTab_OnChecked">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Width="17" Height="17" Stretch="Uniform" Data="{DynamicResource Icon.Settings}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="应用设置"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="RecordsTabButton" Style="{StaticResource SideNavToggle}"
                                 GroupName="PrimaryNavigation"
                                 IsChecked="True" Checked="HistoryTab_OnChecked">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Width="17" Height="17" Stretch="Uniform" Data="{DynamicResource Icon.History}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="翻译历史"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </Grid>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
        <Grid x:Name="HistoryContent" Margin="34,28,34,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="4" Margin="0,0,0,22" HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.SurfaceRaised}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Medium}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AllTabButton" GroupName="HistoryFilters"
                                 Style="{StaticResource ContentFilterToggle}"
                                 IsChecked="True" Checked="HistoryFilter_OnChecked" Content="翻译历史" />
                    <RadioButton x:Name="StarredTabButton" GroupName="HistoryFilters"
                                 Style="{StaticResource ContentFilterToggle}"
                                 Checked="HistoryFilter_OnChecked" Content="我的收藏" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="52*" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Large}"
                        Background="{DynamicResource Brush.Surface}">
                    <Grid>
                        <ListBox x:Name="HistoryGrid" BorderThickness="0" Background="{DynamicResource Brush.Transparent}"
                                 ItemContainerStyle="{StaticResource HistoryItem}"
                                 ItemTemplate="{StaticResource HistoryItemTemplate}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="HistoryGrid_OnSelectionChanged"
                                 ScrollViewer.ScrollChanged="HistoryGrid_OnScrollChanged" />
                        <TextBlock x:Name="EmptyStateText" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="28" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <StackPanel x:Name="DetailEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="300" Margin="28" Panel.ZIndex="1">
                        <Border Width="46" Height="46" HorizontalAlignment="Center" Margin="0,0,0,14"
                                Background="{DynamicResource Brush.SurfaceSubtle}" CornerRadius="23">
                            <Path Width="20" Height="20" Data="{DynamicResource Icon.History}" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="选择一条记录查看详情" />
                        <TextBlock Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="左侧只显示原文；选中后可在这里完整查看、复制原文和译文。" />
                    </StackPanel>

                    <Grid x:Name="DetailCards" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Large}"
                            Background="{DynamicResource Brush.Surface}" Padding="20,18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}"
                                        AutomationProperties.Name="复制原文"
                                        ToolTip="复制原文" Click="CopySource_OnClick">
                                    <Path Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource Icon.Copy}"
                                          Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Button>
                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="原文" />
                            </DockPanel>
                            <TextBox x:Name="SourceDetail" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True"
                                     BorderThickness="0" Background="{DynamicResource Brush.Transparent}" Padding="0"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Large}"
                            Background="{DynamicResource Brush.Surface}" Padding="20,18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}"
                                        AutomationProperties.Name="复制译文"
                                        ToolTip="复制译文" Click="CopyResult_OnClick">
                                    <Path Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource Icon.Copy}"
                                          Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Button>
                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="译文" />
                            </DockPanel>
                            <TextBox x:Name="ResultDetail" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True"
                                     BorderThickness="0" Background="{DynamicResource Brush.Transparent}" Padding="0"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="MetadataText" Grid.Row="3" Margin="2,10,0,0" TextWrapping="Wrap"
                               FontSize="{DynamicResource Size.Caption}"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <ContentControl x:Name="SettingsHost" Visibility="Collapsed"
                        KeyboardNavigation.TabNavigation="Local" />
        </Grid>
    </Grid>
</Window>
