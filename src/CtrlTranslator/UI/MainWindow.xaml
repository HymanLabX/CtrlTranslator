<Window x:Class="CtrlTranslator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CtrlTranslator.UI"
        Title="CtrlTranslator 翻译历史" Width="900" Height="620"
        MinWidth="760" MinHeight="520"
        Background="{DynamicResource Brush.Bg}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ui:SingleLineConverter x:Key="SingleLine" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 两个页签做成分段按钮：原来是把 DataGrid 用 Margin="2,34,2,0" 硬顶在
             TabControl 的内容区上面，换字号或 DPI 就会错位。这里让它们各就各位。 -->
        <Style x:Key="SegmentToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shell" Background="Transparent"
                                CornerRadius="{DynamicResource Radius.Small}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DESIGN.md §3.4：行高 Auto、内边距 12,10、行间 1px 分隔线、不要交替底色，
             悬停整行 Hover 底，选中行 AccentSubtle 底 + 左侧 2px Accent 竖条。 -->
        <Style x:Key="HistoryItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Shell" Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar" Grid.Column="0" Background="Transparent" />
                                <ContentPresenter Grid.Column="1" Margin="12,10" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HistoryItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding SourceText, Converter={StaticResource SingleLine}}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource Size.Body}"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="{Binding ResultText, Converter={StaticResource SingleLine}}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource Size.BodySmall}"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ModeId}"
                                   FontSize="{DynamicResource Size.Caption}"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                        <Path Margin="6,0,0,0" Width="11" Height="11" Stretch="Uniform"
                              VerticalAlignment="Center"
                              Data="{DynamicResource Icon.StarFilled}"
                              Fill="{DynamicResource Brush.Accent}"
                              Stroke="{DynamicResource Brush.Accent}"
                              Visibility="{Binding Starred, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                               Margin="0,3,0,0" HorizontalAlignment="Right"
                               FontSize="{DynamicResource Size.Caption}"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="16,7"
                    Style="{StaticResource Button.Secondary}"
                    Content="导出 CSV…" Click="ExportButton_OnClick" />
            <Grid>
                <TextBox x:Name="SearchBox" Height="34" Padding="32,7,10,7"
                         TextChanged="SearchBox_OnTextChanged" />
                <Path Width="14" Height="14" Margin="11,0,0,0" Stretch="Uniform"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      Data="{DynamicResource Icon.Search}"
                      Stroke="{DynamicResource Brush.TextTertiary}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <TextBlock Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           Text="搜索原文或译文">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="45*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="AllTabButton" Style="{StaticResource SegmentToggle}"
                             Content="全部历史" IsChecked="True" Checked="HistoryTab_OnChecked" />
                <RadioButton x:Name="StarredTabButton" Style="{StaticResource SegmentToggle}"
                             Content="我的收藏" Checked="HistoryTab_OnChecked" />
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Medium}"
                    Background="{DynamicResource Brush.Surface}">
                <Grid>
                    <ListBox x:Name="HistoryGrid" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource HistoryItem}"
                             ItemTemplate="{StaticResource HistoryItemTemplate}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="HistoryGrid_OnSelectionChanged"
                             ScrollViewer.ScrollChanged="HistoryGrid_OnScrollChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制原文" Click="CopySource_OnClick" />
                                <MenuItem Header="复制译文" Click="CopyResult_OnClick" />
                                <Separator />
                                <MenuItem x:Name="StarMenuItem" Header="收藏 / 取消收藏" Click="ToggleStar_OnClick" />
                                <MenuItem Header="删除这条记录" Click="DeleteRecord_OnClick" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <TextBlock x:Name="EmptyStateText" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="24" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Medium}"
                        Background="{DynamicResource Brush.Surface}" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}"
                                    ToolTip="复制原文" Click="CopySource_OnClick">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Data="{DynamicResource Icon.Copy}"
                                      Stroke="{DynamicResource Brush.TextSecondary}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round" />
                            </Button>
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="原文" />
                        </DockPanel>
                        <TextBox x:Name="SourceDetail" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True"
                                 BorderThickness="0" Background="Transparent" Padding="0"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Height="1" Margin="0,10"
                        Background="{DynamicResource Brush.Border}" />

                <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Medium}"
                        Background="{DynamicResource Brush.Surface}" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}"
                                    ToolTip="复制译文" Click="CopyResult_OnClick">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Data="{DynamicResource Icon.Copy}"
                                      Stroke="{DynamicResource Brush.TextSecondary}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round" />
                            </Button>
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="译文" />
                        </DockPanel>
                        <TextBox x:Name="ResultDetail" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True"
                                 BorderThickness="0" Background="Transparent" Padding="0"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                    </Grid>
                </Border>

                <TextBlock x:Name="MetadataText" Grid.Row="3" Margin="2,10,0,0" TextWrapping="Wrap"
                           FontSize="{DynamicResource Size.Caption}"
                           Foreground="{DynamicResource Brush.TextTertiary}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
