<Window x:Class="CtrlTranslator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CtrlTranslator 翻译历史" Width="1040" Height="700"
        MinWidth="820" MinHeight="560" WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="导出 CSV…" Padding="16,7"
                    Click="ExportButton_OnClick"/>
            <TextBox x:Name="SearchBox" Width="340" Height="34" Padding="9,6"
                     HorizontalAlignment="Left" ToolTip="搜索原文或译文"
                     TextChanged="SearchBox_OnTextChanged"/>
            <TextBlock Margin="12,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="输入关键词搜索原文和译文"/>
        </DockPanel>

        <TabControl x:Name="HistoryTabs" Grid.Row="1" SelectionChanged="HistoryTabs_OnSelectionChanged">
            <TabItem Header="全部历史" Tag="all"/>
            <TabItem Header="我的收藏" Tag="starred"/>
        </TabControl>

        <DataGrid x:Name="HistoryGrid" Grid.Row="1" Margin="2,34,2,0"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionChanged="HistoryGrid_OnSelectionChanged"
                  ScrollViewer.ScrollChanged="HistoryGrid_OnScrollChanged">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="复制原文" Click="CopySource_OnClick"/>
                    <MenuItem Header="复制译文" Click="CopyResult_OnClick"/>
                    <Separator/>
                    <MenuItem x:Name="StarMenuItem" Header="收藏 / 取消收藏" Click="ToggleStar_OnClick"/>
                    <MenuItem Header="删除这条记录" Click="DeleteRecord_OnClick"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="145"/>
                <DataGridTextColumn Header="模式" Binding="{Binding ModeId}" Width="95"/>
                <DataGridTextColumn Header="原文" Binding="{Binding SourceText}" Width="*"/>
                <DataGridTextColumn Header="译文" Binding="{Binding ResultText}" Width="*"/>
                <DataGridCheckBoxColumn Header="收藏" Binding="{Binding Starred}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="原文"/>
                <TextBox x:Name="SourceDetail" Grid.Row="1" Margin="0,7,0,8" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="译文"/>
                <TextBox x:Name="ResultDetail" Grid.Column="2" Grid.Row="1" Margin="0,7,0,8" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                <TextBlock x:Name="MetadataText" Grid.Row="2" Grid.ColumnSpan="3" Foreground="{DynamicResource Brush.TextSecondary}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
