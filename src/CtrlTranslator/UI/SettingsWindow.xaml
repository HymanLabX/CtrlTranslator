<UserControl x:Class="CtrlTranslator.UI.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.SurfaceSubtle}"
             Loaded="SettingsView_OnLoaded"
             Unloaded="SettingsView_OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,18,8" />
            <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Large}" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Size.Title}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{DynamicResource Size.BodySmall}" />
        </Style>
        <Style x:Key="SettingsTabToggle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shell" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource Brush.Transparent}"
                                BorderBrush="{DynamicResource Brush.Transparent}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProfileItemTemplate">
            <Grid Margin="2,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"
                              Data="{DynamicResource Icon.Warning}" Stretch="Uniform"
                              Stroke="{DynamicResource Brush.Danger}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" Visibility="{Binding FailedVisibility}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" Margin="0,2,0,0"
                               FontSize="{DynamicResource Size.Caption}"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Padding="7,2"
                        CornerRadius="{DynamicResource Radius.Small}"
                        Background="{DynamicResource Brush.AccentSubtle}"
                        Visibility="{Binding CurrentVisibility}">
                    <TextBlock Text="当前" FontSize="{DynamicResource Size.Caption}"
                               Foreground="{DynamicResource Brush.Accent}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DiagnosticItemTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path x:Name="Symbol" Width="15" Height="15" VerticalAlignment="Center"
                      Stretch="Uniform" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           FontSize="{DynamicResource Size.BodySmall}" />
                <TextBlock Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Top"
                           Text="{Binding DurationMilliseconds, StringFormat={}{0} ms}"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           FontSize="{DynamicResource Size.Caption}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter TargetName="Symbol" Property="Data" Value="{DynamicResource Icon.Check}" />
                    <Setter TargetName="Symbol" Property="Stroke" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter TargetName="Symbol" Property="Data" Value="{DynamicResource Icon.Warning}" />
                    <Setter TargetName="Symbol" Property="Stroke" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Symbol" Property="Data" Value="{DynamicResource Icon.Error}" />
                    <Setter TargetName="Symbol" Property="Stroke" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="28,12"
                Background="{DynamicResource Brush.SurfaceRaised}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.TextTertiary}"
                       Text="修改后自动保存" />
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Margin="28,18,28,0" Padding="4" HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.SurfaceRaised}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Medium}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="GeneralTabButton" GroupName="SettingsTabs" Tag="0"
                                 Style="{StaticResource SettingsTabToggle}" IsChecked="True"
                                 Checked="SettingsTab_OnChecked" Content="常规" />
                    <RadioButton x:Name="ServiceTabButton" GroupName="SettingsTabs" Tag="1"
                                 Style="{StaticResource SettingsTabToggle}"
                                 Checked="SettingsTab_OnChecked" Content="翻译服务" />
                    <RadioButton x:Name="PreferenceTabButton" GroupName="SettingsTabs" Tag="2"
                                 Style="{StaticResource SettingsTabToggle}"
                                 Checked="SettingsTab_OnChecked" Content="翻译偏好" />
                    <RadioButton x:Name="PrivacyTabButton" GroupName="SettingsTabs" Tag="3"
                                 Style="{StaticResource SettingsTabToggle}"
                                 Checked="SettingsTab_OnChecked" Content="隐私与数据" />
                    <RadioButton x:Name="AboutTabButton" GroupName="SettingsTabs" Tag="4"
                                 Style="{StaticResource SettingsTabToggle}"
                                 Checked="SettingsTab_OnChecked" Content="关于" />
                </StackPanel>
            </Border>

            <Grid x:Name="SectionHost" Grid.Row="1">
                <!-- ==================== 常规 ==================== -->
                <ScrollViewer x:Name="GeneralSection" VerticalScrollBarVisibility="Auto" Padding="28,20,28,24">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="划词触发" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="启用划词翻译" />
                                    <CheckBox x:Name="EnabledCheckBox" Grid.Row="0" Grid.Column="1" Margin="0,8,0,8"
                                              Content="双击触发键后翻译选中的文字" Click="GeneralCheckBox_OnClick" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="触发键" />
                                    <ComboBox x:Name="TriggerKeyCombo" Grid.Row="1" Grid.Column="1" Width="160"
                                              HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                              SelectionChanged="TriggerSetting_OnSelectionChanged">
                                        <ComboBoxItem Content="Ctrl" /><ComboBoxItem Content="Shift" /><ComboBoxItem Content="Alt" />
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="双击间隔" />
                                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,5,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="DoubleTapSlider" Minimum="150" Maximum="800" TickFrequency="10"
                                                IsSnapToTickEnabled="True" ValueChanged="DoubleTapSlider_OnValueChanged" />
                                        <TextBlock x:Name="DoubleTapValueText" Grid.Column="1" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </Grid>
                                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="单次按键最长时长" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="MaxKeyHoldBox" Width="120" Style="{StaticResource FieldBox}"
                                                 LostKeyboardFocus="TriggerTextBox_OnLostKeyboardFocus" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Text="毫秒（1–5000）" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="取词等待时间" />
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="ClipboardWaitBox" Width="120" Style="{StaticResource FieldBox}"
                                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Text="毫秒（100–1000）" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.AccentSubtle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="实时双击测试" />
                                <TextBlock x:Name="DoubleTapTestText" FontSize="{DynamicResource Size.Heading}"
                                           Text="在这里双击触发键试试" />
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource Hint}"
                                           Text="每次有效敲击会显示一个圆点；识别到双击后会显示成功标记。上面的设置修改后会立即用于测试。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="应用与浮窗" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="开机自动启动" />
                                    <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Row="0" Grid.Column="1" Margin="0,8,0,8"
                                              Content="登录 Windows 后自动启动 CtrlTranslator"
                                              Click="StartWithWindowsCheckBox_OnClick" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="浮窗字号" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="PopupFontSizeBox" Width="120" Style="{StaticResource FieldBox}"
                                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Text="DIP（10–24）" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="浮窗最大宽度" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="PopupMaxWidthBox" Width="120" Style="{StaticResource FieldBox}"
                                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Text="DIP（260–900）" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="浮窗最大高度" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="PopupMaxHeightBox" Width="120" Style="{StaticResource FieldBox}"
                                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Text="DIP（180–900）" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== 翻译服务 ==================== -->
                <ScrollViewer x:Name="ProfilesSection" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Padding="28,20,28,24">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="310" /><ColumnDefinition Width="18" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource CardTitle}" Text="服务商档案" />
                                <ListBox x:Name="ProfilesList" Grid.Row="1" MinHeight="180"
                                         ItemTemplate="{StaticResource ProfileItemTemplate}"
                                         HorizontalContentAlignment="Stretch"
                                         SelectionChanged="ProfilesList_OnSelectionChanged" />
                                <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Top">
                                    <Button x:Name="MoveProfileUpButton" Width="112" Margin="0,0,0,6" Content="上移"
                                            Click="MoveProfileUpButton_OnClick" />
                                    <Button x:Name="MoveProfileDownButton" Width="112" Margin="0,0,0,14" Content="下移"
                                            Click="MoveProfileDownButton_OnClick" />
                                    <Button x:Name="SetCurrentProfileButton" Width="112" Margin="0,0,0,6"
                                            Style="{StaticResource Button.Primary}" Content="设为当前"
                                            Click="SetCurrentProfileButton_OnClick" />
                                    <Button Width="112" Margin="0,0,0,6" Content="新建档案"
                                            Click="AddProfileButton_OnClick" />
                                    <Button x:Name="DeleteProfileButton" Width="112" Content="删除档案"
                                            Click="DeleteProfileButton_OnClick" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="ProfileFailureCard" Style="{StaticResource Card}"
                                Background="{DynamicResource Brush.DangerBg}"
                                BorderBrush="{DynamicResource Brush.Danger}" Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Center"
                                        Content="解除失效标记" Click="ClearFailureButton_OnClick" />
                                <TextBlock x:Name="ProfileFailureText" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Danger}" />
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="连接与常用参数" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="175" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="档案名称" />
                                    <TextBox x:Name="ProfileNameBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                                             LostKeyboardFocus="ProfileNameBox_OnLostKeyboardFocus" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="服务商预设" />
                                    <ComboBox x:Name="ProviderPresetCombo" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                                              SelectionChanged="ProviderPresetCombo_OnSelectionChanged" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="接口地址（Base URL）" />
                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBox x:Name="BaseUrlBox" Style="{StaticResource FieldBox}"
                                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                        <TextBlock x:Name="BaseUrlHintText" Margin="0,0,0,6" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="API Key" />
                                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="ApiKeyPasswordBox" VerticalContentAlignment="Center"
                                                     LostKeyboardFocus="ApiKeyControl_OnLostKeyboardFocus" />
                                        <TextBox x:Name="ApiKeyVisibleBox" VerticalContentAlignment="Center" Visibility="Collapsed"
                                                 LostKeyboardFocus="ApiKeyControl_OnLostKeyboardFocus" />
                                        <Button x:Name="ToggleApiKeyButton" Grid.Column="1" Width="76" Margin="8,0,0,0"
                                                Content="显示" Click="ToggleApiKeyButton_OnClick" />
                                    </Grid>
                                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="模型名称" />
                                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ModelCombo" IsEditable="True" VerticalContentAlignment="Center"
                                                  LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                        <Button x:Name="FetchModelsButton" Grid.Column="1" Margin="8,0,0,0"
                                                Content="拉取可用模型" Click="FetchModelsButton_OnClick" />
                                    </Grid>
                                    <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="随机性（Temperature）" />
                                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="TemperatureBox" Width="120" Style="{StaticResource FieldBox}"
                                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Text="0–2；翻译建议 0.2" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="最大输出长度" />
                                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="MaxTokensBox" Width="120" Style="{StaticResource FieldBox}"
                                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Text="Token（1–128000）" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Expander x:Name="AdvancedModelSettingsExpander" IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Margin="0,1,0,1">
                                        <TextBlock FontSize="{DynamicResource Size.Title}" FontWeight="SemiBold" Text="高级设置" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Hint}"
                                                   Text="超时、流式回退和服务商专用请求参数" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,18,0,0">
                                    <TextBlock x:Name="ModelParamsCaption" Margin="0,0,0,14" Style="{StaticResource Hint}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="175" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="整体请求超时" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="RequestTimeoutBox" Width="120" Style="{StaticResource FieldBox}"
                                                     LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.TextSecondary}" Text="秒（2–15）" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="首字响应超时" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="FirstTokenTimeoutBox" Width="120" Style="{StaticResource FieldBox}"
                                                     LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.TextSecondary}" Text="秒（1–10，且小于整体超时）" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="流式回退延迟" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="StreamFallbackDelayBox" Width="120" Style="{StaticResource FieldBox}"
                                                     LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.TextSecondary}" Text="毫秒（0–10000）" />
                                        </StackPanel>
                                    </Grid>
                                    <Separator Margin="0,14,0,18" />
                                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="额外请求参数（JSON）" />
                                    <TextBox x:Name="ExtraRequestBodyBox" Height="108" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource Font.Mono}"
                                             Margin="0,0,0,3" TextChanged="ExtraRequestBodyBox_OnTextChanged"
                                             LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                    <TextBlock x:Name="ExtraRequestBodyError" Margin="0,0,0,8"
                                               Foreground="{DynamicResource Brush.Danger}" Visibility="Collapsed"
                                               Text="这段不是合法的 JSON，程序已忽略" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Margin="0,0,6,4" Content="DeepSeek / 智谱：关闭思考"
                                                Tag="deepseek" Click="ExtraPresetButton_OnClick" />
                                        <Button Margin="0,0,6,4" Content="通义 / 硅基流动：关闭思考"
                                                Tag="qwen" Click="ExtraPresetButton_OnClick" />
                                        <Button Margin="0,0,6,4" Content="OpenAI：最低推理"
                                                Tag="openai" Click="ExtraPresetButton_OnClick" />
                                        <Button Margin="0,0,0,4" Content="清空" Tag="clear"
                                                Click="ExtraPresetButton_OnClick" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="仅在服务商文档明确要求时填写。预设按钮会生成对应服务商的常用参数；切换档案时会自动带上各自设置。" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button x:Name="TestProfileButton" DockPanel.Dock="Right" MinWidth="112"
                                            Style="{StaticResource Button.Primary}"
                                            Content="开始检测" Click="TestProfileButton_OnClick" />
                                    <Button x:Name="CopyReportButton" DockPanel.Dock="Right" Margin="0,0,8,0"
                                            Content="复制诊断报告" Visibility="Collapsed"
                                            Click="CopyReportButton_OnClick" />
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"
                                               Text="连接检测" />
                                </DockPanel>
                                <ProgressBar x:Name="TestProgressBar" Height="4" Margin="0,0,0,12"
                                             IsIndeterminate="True" Visibility="Collapsed" />
                                <TextBlock x:Name="TestStatusText" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                           Text="检查配置、网络、鉴权、模型和翻译链路，定位连接问题。" />
                                <ItemsControl x:Name="TestResultsList" ItemTemplate="{StaticResource DiagnosticItemTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== 翻译偏好 ==================== -->
                <ScrollViewer x:Name="BehaviorSection" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Padding="28,20,28,24">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock x:Name="CurrentModeStatusText" Margin="0,0,0,8" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <ListBox x:Name="ModesList" Grid.Row="1" DisplayMemberPath="Name" MinHeight="220"
                                             SelectionChanged="ModesList_OnSelectionChanged" />
                                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                        <Button x:Name="ApplyModeButton" Style="{StaticResource Button.Primary}"
                                                Margin="0,0,6,6" Content="应用" Click="ApplyModeButton_OnClick" />
                                        <Button Margin="0,0,6,6" Content="新建" Click="NewModeButton_OnClick" />
                                        <Button x:Name="DeleteModeButton" Margin="0,0,6,6" Content="删除"
                                                Click="DeleteModeButton_OnClick" />
                                    </WrapPanel>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button x:Name="RestoreModeButton" DockPanel.Dock="Right" Content="恢复默认"
                                                Click="RestoreModeButton_OnClick" />
                                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="模式名称" />
                                    </DockPanel>
                                    <TextBox x:Name="ModeNameBox" Grid.Row="1" Margin="0,0,0,14"
                                             LostKeyboardFocus="ModeNameBox_OnLostKeyboardFocus" />
                                    <TextBlock Grid.Row="2" Margin="0,0,0,8" FontWeight="SemiBold" Text="提示词模板" />
                                    <TextBox x:Name="ModePromptBox" Grid.Row="3" MinHeight="210"
                                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource Font.Mono}"
                                             LostKeyboardFocus="ModePromptBox_OnLostKeyboardFocus" />
                                    <TextBlock Grid.Row="4" Margin="0,8,0,0" Style="{StaticResource Hint}"
                                               Text="可用占位符：{target_lang}  {fallback_lang}。内置模式改乱后可以恢复默认。" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="语言方向与词典" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="目标语言" />
                                    <TextBox x:Name="TargetLanguageBox" Grid.Row="0" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                             Style="{StaticResource FieldBox}" LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="原文已是目标语言时" />
                                    <TextBox x:Name="FallbackLanguageBox" Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                             Style="{StaticResource FieldBox}" LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="词典模式词数阈值" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="WordThresholdBox" Width="120" Style="{StaticResource FieldBox}"
                                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Text="词（1–8）" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== 隐私与数据 ==================== -->
                <ScrollViewer x:Name="PrivacySection" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Padding="28,20,28,24">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="隐私保护" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="长文本确认阈值" />
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="LongTextThresholdBox" Width="120" Style="{StaticResource FieldBox}"
                                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Text="字符；0 表示不确认" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="隐私模式" />
                                    <CheckBox x:Name="PrivacyModeCheckBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,8"
                                              Content="翻译时不查询缓存，也不写入历史" Click="GeneralCheckBox_OnClick" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="详细日志" />
                                    <CheckBox x:Name="DetailedLoggingCheckBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                              Content="在日志中记录选中的原文（可能包含隐私内容）" Click="GeneralCheckBox_OnClick" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="应用黑名单" />
                                <TextBlock Margin="0,0,0,12" Style="{StaticResource Hint}"
                                           Text="在这些程序中选中文字时，CtrlTranslator 不会读取或翻译。" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="RunningProcessesCombo" IsEditable="True" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" Content="刷新列表"
                                            Click="RefreshProcessesButton_OnClick" />
                                    <Button Grid.Column="2" Margin="8,0,0,0" Content="添加"
                                            Click="AddBlacklistButton_OnClick" />
                                </Grid>
                                <ListBox x:Name="BlacklistList" Height="140" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Content="移除选中项" Click="RemoveBlacklistButton_OnClick" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="数据管理" />
                                <WrapPanel Margin="0,0,0,12">
                                    <Button Margin="0,0,8,8" Content="导出历史为 CSV…"
                                            Click="ExportHistoryButton_OnClick" />
                                    <Button Margin="0,0,8,8" Content="打开数据文件夹" Tag="data"
                                            Click="OpenFolderButton_OnClick" />
                                    <Button Margin="0,0,8,8" Content="打开日志文件夹" Tag="logs"
                                            Click="OpenFolderButton_OnClick" />
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Margin="0,0,8,8" Content="清空历史记录"
                                            Click="ClearAllHistoryButton_OnClick" />
                                    <Button Margin="0,0,8,8" Content="清空缓存"
                                            Click="ClearCacheButton_OnClick" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="清空操作只删除未收藏的记录；已收藏内容会保留。删除某条收藏，请回到翻译记录页逐条操作。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== 关于 ==================== -->
                <ScrollViewer x:Name="AboutSection" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Padding="28,20,28,24">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center" Margin="0,10,0,28">
                            <Image Width="72" Height="72" HorizontalAlignment="Center"
                                   Source="pack://application:,,,/Assets/ctrltranslator.ico"
                                   AutomationProperties.Name="CtrlTranslator 程序图标" />
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource Font.Display}"
                                       FontSize="{DynamicResource Size.Heading}" FontWeight="SemiBold"
                                       Text="CtrlTranslator" />
                            <Border Margin="0,10,0,12" Padding="10,4" HorizontalAlignment="Center"
                                    Background="{DynamicResource Brush.SurfaceSubtle}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Pill}">
                                <TextBlock x:Name="AboutVersionText" FontSize="{DynamicResource Size.BodySmall}"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                            <Button x:Name="CheckUpdateButton" HorizontalAlignment="Center"
                                    Style="{StaticResource Button.Primary}" Content="检查更新"
                                    Click="CheckUpdateButton_OnClick" />
                        </StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <CheckBox x:Name="AutoCheckUpdatesCheckBox" DockPanel.Dock="Right"
                                              Content="自动检查更新" Click="GeneralCheckBox_OnClick" />
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"
                                               Text="软件更新" />
                                </DockPanel>
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="权限与兼容性" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Path Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                          Data="{DynamicResource Icon.Info}" Stretch="Uniform"
                                          Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="管理员权限程序" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Hint}"
                                                   Text="普通权限运行时，无法在管理员权限程序中划词。需要时可右键 CtrlTranslator，选择“以管理员身份运行”。" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Path Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                          Data="{DynamicResource Icon.Info}" Stretch="Uniform"
                                          Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="安全软件提醒" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Hint}"
                                                   Text="全局按键监听和剪贴板读取可能触发安全软件提示。如确认下载来源可信，可将程序加入允许列表。" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
