<Window x:Class="CtrlTranslator.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CtrlTranslator 设置" Width="920" Height="720"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Closed="Window_OnClosed">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,12,6" />
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Margin" Value="0,5,0,5" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#276A36"
                       Text="设置修改后会自动保存并立即生效。" />
            <Button Grid.Column="1" Width="88" Height="30" Content="关闭" IsCancel="True"
                    Click="CloseButton_OnClick" />
        </Grid>

        <TabControl x:Name="SettingsTabs">
            <TabItem Header="翻译服务">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SectionTitle}"
                                   Text="翻译服务" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="服务商预设" />
                        <ComboBox x:Name="ProviderPresetCombo" Grid.Row="1" Grid.Column="1"
                                  Style="{StaticResource FieldBox}"
                                  SelectionChanged="ProviderPresetCombo_OnSelectionChanged" />

                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Base URL" />
                        <TextBox x:Name="BaseUrlBox" Grid.Row="2" Grid.Column="1"
                                 Style="{StaticResource FieldBox}"
                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />

                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="API Key" />
                        <Grid Grid.Row="3" Grid.Column="1" Margin="0,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyPasswordBox" MinHeight="28"
                                         LostKeyboardFocus="ApiKeyControl_OnLostKeyboardFocus" />
                            <TextBox x:Name="ApiKeyVisibleBox" MinHeight="28" Visibility="Collapsed"
                                     LostKeyboardFocus="ApiKeyControl_OnLostKeyboardFocus" />
                            <Button Grid.Column="1" Width="72" Margin="8,0,0,0" Content="显示"
                                    x:Name="ToggleApiKeyButton" Click="ToggleApiKeyButton_OnClick" />
                        </Grid>

                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="模型名" />
                        <Grid Grid.Row="4" Grid.Column="1" Margin="0,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ModelCombo" IsEditable="True" MinHeight="28"
                                      LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                            <Button x:Name="FetchModelsButton" Grid.Column="1" Margin="8,0,0,0"
                                    Padding="12,3" Content="拉取可用模型"
                                    Click="FetchModelsButton_OnClick" />
                        </Grid>

                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="请求参数" />
                        <WrapPanel Grid.Row="5" Grid.Column="1" Margin="0,5,0,5">
                            <TextBlock VerticalAlignment="Center" Text="Temperature" />
                            <TextBox x:Name="TemperatureBox" Width="64" Margin="8,0,18,0"
                                     LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                            <TextBlock VerticalAlignment="Center" Text="最大输出长度" />
                            <TextBox x:Name="MaxTokensBox" Width="82" Margin="8,0,0,0"
                                     LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                        </WrapPanel>

                        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="超时（秒）" />
                        <WrapPanel Grid.Row="6" Grid.Column="1" Margin="0,5,0,5">
                            <TextBlock VerticalAlignment="Center" Text="整体" />
                            <TextBox x:Name="RequestTimeoutBox" Width="64" Margin="8,0,18,0"
                                     LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                            <TextBlock VerticalAlignment="Center" Text="首字" />
                            <TextBox x:Name="FirstTokenTimeoutBox" Width="64" Margin="8,0,10,0"
                                     LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                            <TextBlock VerticalAlignment="Center" Foreground="#666"
                                       Text="首字超时必须小于整体超时" />
                        </WrapPanel>

                        <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="额外请求参数" />
                        <TextBox x:Name="ExtraRequestBodyBox" Grid.Row="7" Grid.Column="1"
                                 Height="92" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                 Margin="0,5,0,3" TextChanged="ExtraRequestBodyBox_OnTextChanged"
                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />

                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="ExtraRequestBodyError"
                                   Foreground="#B3261E" Visibility="Collapsed"
                                   Text="这段不是合法的 JSON，已忽略" />

                        <WrapPanel Grid.Row="9" Grid.Column="1" Margin="0,5,0,5">
                            <Button Margin="0,0,6,4" Padding="8,3" Content="DeepSeek / 智谱：关闭思考"
                                    Tag="deepseek" Click="ExtraPresetButton_OnClick" />
                            <Button Margin="0,0,6,4" Padding="8,3" Content="通义千问：关闭思考"
                                    Tag="qwen" Click="ExtraPresetButton_OnClick" />
                            <Button Margin="0,0,6,4" Padding="8,3" Content="OpenAI：最低推理"
                                    Tag="openai" Click="ExtraPresetButton_OnClick" />
                            <Button Margin="0,0,0,4" Padding="8,3" Content="清空"
                                    Tag="clear" Click="ExtraPresetButton_OnClick" />
                        </WrapPanel>

                        <TextBlock Grid.Row="10" Grid.Column="1" Foreground="#666" TextWrapping="Wrap"
                                   Text="大多数模型默认会先『思考』再回答，这让划词翻译又慢又贵。保持默认值即可；换了服务商发现变慢，就点对应的预设按钮。" />

                        <Button Grid.Row="11" Grid.Column="1" HorizontalAlignment="Left"
                                Margin="0,14,0,4" Padding="14,5" Content="一键诊断"
                                Click="DiagnosticsButton_OnClick" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="翻译行为">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SectionTitle}"
                               Text="翻译行为" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="当前模式" />
                    <ComboBox x:Name="CurrentModeCombo" Grid.Row="1" Grid.Column="1"
                              DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,5,0,8"
                              SelectionChanged="CurrentModeCombo_OnSelectionChanged" />

                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="模式管理"
                               VerticalAlignment="Top" />
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ListBox x:Name="ModesList" DisplayMemberPath="Name" MinHeight="180"
                                 SelectionChanged="ModesList_OnSelectionChanged" />
                        <WrapPanel Grid.Row="1" Margin="0,8,0,10">
                            <Button Padding="12,4" Margin="0,0,6,0" Content="新建" Click="NewModeButton_OnClick" />
                            <Button x:Name="EditModeButton" Padding="12,4" Margin="0,0,6,0"
                                    Content="编辑" Click="EditModeButton_OnClick" />
                            <Button x:Name="DeleteModeButton" Padding="12,4" Margin="0,0,6,0"
                                    Content="删除" Click="DeleteModeButton_OnClick" />
                            <Button x:Name="RestoreModeButton" Padding="12,4"
                                    Content="恢复默认" Click="RestoreModeButton_OnClick" />
                        </WrapPanel>
                    </Grid>

                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="语言方向" />
                    <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,5,0,5">
                        <TextBlock VerticalAlignment="Center" Text="目标语言" />
                        <TextBox x:Name="TargetLanguageBox" Width="120" Margin="8,0,18,0"
                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                        <TextBlock VerticalAlignment="Center" Text="反向语言" />
                        <TextBox x:Name="FallbackLanguageBox" Width="120" Margin="8,0,0,0"
                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                    </WrapPanel>

                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="词典模式词数阈值" />
                    <TextBox x:Name="WordThresholdBox" Grid.Row="4" Grid.Column="1" Width="80"
                             HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                             LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                </Grid>
            </TabItem>

            <TabItem Header="触发方式">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SectionTitle}" Text="触发方式" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="触发键" />
                        <ComboBox x:Name="TriggerKeyCombo" Grid.Row="1" Grid.Column="1" Width="150"
                                  HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                  SelectionChanged="TriggerSetting_OnSelectionChanged">
                            <ComboBoxItem Content="Ctrl" /><ComboBoxItem Content="Shift" /><ComboBoxItem Content="Alt" />
                        </ComboBox>
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="双击间隔（毫秒）" />
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,5,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                            <Slider x:Name="DoubleTapSlider" Minimum="150" Maximum="800" TickFrequency="10"
                                    IsSnapToTickEnabled="True" ValueChanged="DoubleTapSlider_OnValueChanged" />
                            <TextBlock x:Name="DoubleTapValueText" Grid.Column="1" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="单次按键最长时长（毫秒）" />
                        <TextBox x:Name="MaxKeyHoldBox" Grid.Row="3" Grid.Column="1" Width="100"
                                 HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                 LostKeyboardFocus="TriggerTextBox_OnLostKeyboardFocus" />
                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="取词等待时间（毫秒）" />
                        <TextBox x:Name="ClipboardWaitBox" Grid.Row="4" Grid.Column="1" Width="100"
                                 HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="启用划词" />
                        <CheckBox x:Name="EnabledCheckBox" Grid.Row="5" Grid.Column="1" Margin="0,8,0,8"
                                  Content="双击触发键后翻译选中文字" Click="GeneralCheckBox_OnClick" />

                        <Border Grid.Row="6" Grid.ColumnSpan="2" BorderBrush="#8A8A8A" BorderThickness="1"
                                CornerRadius="6" Padding="18" Margin="0,18,0,0" Background="#F6F7F8">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="实时双击测试" />
                                <TextBlock x:Name="DoubleTapTestText" Margin="0,12,0,0" FontSize="18"
                                           Text="在这里双击触发键试试" />
                                <TextBlock Margin="0,8,0,0" Foreground="#666" TextWrapping="Wrap"
                                           Text="每次有效敲击会显示一个圆点；识别到双击后会显示成功标记。修改触发键或间隔后，测试立即使用新设置。" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="隐私与安全">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SectionTitle}" Text="隐私与安全" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="应用黑名单"
                                   VerticalAlignment="Top" />
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="140" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,5,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="RunningProcessesCombo" IsEditable="True" MinHeight="28" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,3" Content="刷新列表"
                                        Click="RefreshProcessesButton_OnClick" />
                                <Button Grid.Column="2" Margin="8,0,0,0" Padding="10,3" Content="添加"
                                        Click="AddBlacklistButton_OnClick" />
                            </Grid>
                            <ListBox x:Name="BlacklistList" Grid.Row="1" />
                            <Button Grid.Row="2" Margin="0,8,0,8" Padding="10,3" HorizontalAlignment="Left"
                                    Content="移除选中项" Click="RemoveBlacklistButton_OnClick" />
                        </Grid>
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="长文本二次确认阈值" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,5,0,5">
                            <TextBox x:Name="LongTextThresholdBox" Width="100"
                                     LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#666"
                                       Text="字符，0 表示不确认" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="隐私模式" />
                        <CheckBox x:Name="PrivacyModeCheckBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,8"
                                  Content="翻译时不查询缓存，也不写入历史" Click="GeneralCheckBox_OnClick" />
                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="详细日志" />
                        <CheckBox x:Name="DetailedLoggingCheckBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,8"
                                  Content="在日志中记录选中的原文（可能包含隐私内容）" Click="GeneralCheckBox_OnClick" />
                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="历史数据" />
                        <WrapPanel Grid.Row="5" Grid.Column="1" Margin="0,8,0,8">
                            <Button Padding="12,4" Margin="0,0,8,0" Content="清空所有历史"
                                    Click="ClearAllHistoryButton_OnClick" />
                            <Button Padding="12,4" Content="清空缓存" Click="ClearCacheButton_OnClick" />
                        </WrapPanel>
                        <TextBlock Grid.Row="6" Grid.Column="1" Foreground="#666" TextWrapping="Wrap"
                                   Text="清空缓存会删除未收藏的历史记录；已经收藏的内容会保留。" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="系统">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SectionTitle}" Text="系统" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="开机自动启动" />
                        <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,8"
                                  Content="登录 Windows 后自动启动 CtrlTranslator"
                                  Click="StartWithWindowsCheckBox_OnClick" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="界面主题" />
                        <ComboBox x:Name="ThemeCombo" Grid.Row="2" Grid.Column="1" Width="160"
                                  HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                  SelectionChanged="GeneralComboBox_OnSelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="System" />
                            <ComboBoxItem Content="浅色" Tag="Light" />
                            <ComboBoxItem Content="深色" Tag="Dark" />
                        </ComboBox>
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="浮窗字号" />
                        <TextBox x:Name="PopupFontSizeBox" Grid.Row="3" Grid.Column="1" Width="100"
                                 HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="浮窗最大宽度" />
                        <TextBox x:Name="PopupMaxWidthBox" Grid.Row="4" Grid.Column="1" Width="100"
                                 HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="浮窗最大高度" />
                        <TextBox x:Name="PopupMaxHeightBox" Grid.Row="5" Grid.Column="1" Width="100"
                                 HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="流式回退延迟（毫秒）" />
                        <TextBox x:Name="StreamFallbackDelayBox" Grid.Row="6" Grid.Column="1" Width="100"
                                 HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                 LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                        <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="文件夹" />
                        <WrapPanel Grid.Row="7" Grid.Column="1" Margin="0,8,0,8">
                            <Button Padding="12,4" Margin="0,0,8,0" Content="打开日志文件夹"
                                    Tag="logs" Click="OpenFolderButton_OnClick" />
                            <Button Padding="12,4" Content="打开数据文件夹"
                                    Tag="data" Click="OpenFolderButton_OnClick" />
                        </WrapPanel>
                        <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Margin="0,18,0,0" Padding="12"
                                   Background="#F3F4F5" TextWrapping="Wrap"
                                   Text="CtrlTranslator v1.0&#x0a;&#x0a;已知限制：普通权限运行时，无法在管理员权限程序中划词；全局键盘钩子和剪贴板读取也可能被安全软件误报。遇到这些情况，请以管理员身份运行或把程序加入安全软件白名单。" />
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
