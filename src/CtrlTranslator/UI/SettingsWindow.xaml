<UserControl x:Class="CtrlTranslator.UI.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Bg}"
             Unloaded="SettingsView_OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,16,8" />
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
            <Setter Property="FontSize" Value="{DynamicResource Size.Heading}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Large}" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Size.Title}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{DynamicResource Size.BodySmall}" />
        </Style>

        <DataTemplate x:Key="ProfileItemTemplate">
            <Grid Margin="2,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"
                              Data="{DynamicResource Icon.Warning}" Stretch="Uniform"
                              Stroke="{DynamicResource Brush.Danger}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" Visibility="{Binding FailedVisibility}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" Margin="0,2,0,0"
                               FontSize="{DynamicResource Size.Caption}"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Padding="7,2"
                        CornerRadius="{DynamicResource Radius.Small}"
                        Background="{DynamicResource Brush.AccentSubtle}"
                        Visibility="{Binding CurrentVisibility}">
                    <TextBlock Text="当前" FontSize="{DynamicResource Size.Caption}"
                               Foreground="{DynamicResource Brush.Accent}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DiagnosticItemTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path x:Name="Symbol" Width="15" Height="15" VerticalAlignment="Center"
                      Stretch="Uniform" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           FontSize="{DynamicResource Size.BodySmall}" />
                <TextBlock Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Top"
                           Text="{Binding DurationMilliseconds, StringFormat={}{0} ms}"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           FontSize="{DynamicResource Size.Caption}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter TargetName="Symbol" Property="Data" Value="{DynamicResource Icon.Check}" />
                    <Setter TargetName="Symbol" Property="Stroke" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter TargetName="Symbol" Property="Data" Value="{DynamicResource Icon.Warning}" />
                    <Setter TargetName="Symbol" Property="Stroke" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Symbol" Property="Data" Value="{DynamicResource Icon.Error}" />
                    <Setter TargetName="Symbol" Property="Stroke" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,14"
                Background="{DynamicResource Brush.SurfaceRaised}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.Success}"
                       Text="设置修改后会自动保存并立即生效。" />
        </Border>

        <Grid x:Name="SectionHost">

            <!-- ==================== 服务商档案 ==================== -->
            <ScrollViewer x:Name="ProfilesSection" VerticalScrollBarVisibility="Auto" Padding="28,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="服务商档案" />
                    <TextBlock Style="{StaticResource SectionCaption}"
                               Text="列表顺序就是降级顺序。当前档案遇到秒级失败（Key 失效、余额不足、限流、5xx、连不上）时，会自动往下试，最多再试 2 个。超时不会触发降级。" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource CardTitle}" Text="档案列表" />
                            <ListBox x:Name="ProfilesList" Grid.Row="1" MinHeight="180"
                                     ItemTemplate="{StaticResource ProfileItemTemplate}"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionChanged="ProfilesList_OnSelectionChanged" />

                            <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Top">
                                <Button x:Name="MoveProfileUpButton" Width="104" Margin="0,0,0,6" Padding="8,4"
                                        Content="上移" Click="MoveProfileUpButton_OnClick" />
                                <Button x:Name="MoveProfileDownButton" Width="104" Margin="0,0,0,14" Padding="8,4"
                                        Content="下移" Click="MoveProfileDownButton_OnClick" />
                                <Button x:Name="SetCurrentProfileButton" Width="104" Margin="0,0,0,6" Padding="8,4"
                                        Style="{StaticResource Button.Primary}"
                                        Content="设为当前" Click="SetCurrentProfileButton_OnClick" />
                                <Button Width="104" Margin="0,0,0,6" Padding="8,4"
                                        Content="新建" Click="AddProfileButton_OnClick" />
                                <Button x:Name="DeleteProfileButton" Width="104" Padding="8,4"
                                        Content="删除" Click="DeleteProfileButton_OnClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ProfileFailureCard" Style="{StaticResource Card}"
                            Background="{DynamicResource Brush.DangerBg}"
                            BorderBrush="{DynamicResource Brush.Danger}"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="14,0,0,0" Padding="12,5"
                                    VerticalAlignment="Center" Content="解除失效标记"
                                    Click="ClearFailureButton_OnClick" />
                            <TextBlock x:Name="ProfileFailureText" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Danger}" />
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="连接信息" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="档案名称" />
                                <TextBox x:Name="ProfileNameBox" Grid.Column="1"
                                         Style="{StaticResource FieldBox}"
                                         LostKeyboardFocus="ProfileNameBox_OnLostKeyboardFocus" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="服务商预设" />
                                <ComboBox x:Name="ProviderPresetCombo" Grid.Column="1"
                                          Style="{StaticResource FieldBox}"
                                          SelectionChanged="ProviderPresetCombo_OnSelectionChanged" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Base URL" />
                                <TextBox x:Name="BaseUrlBox" Grid.Column="1"
                                         Style="{StaticResource FieldBox}"
                                         LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                <TextBlock x:Name="BaseUrlHintText" Grid.Row="1" Grid.Column="1" Margin="0,2,0,5"
                                           Style="{StaticResource Hint}" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="API Key" />
                                <Grid Grid.Column="1" Margin="0,5,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="ApiKeyPasswordBox" MinHeight="40"
                                                 LostKeyboardFocus="ApiKeyControl_OnLostKeyboardFocus" />
                                    <TextBox x:Name="ApiKeyVisibleBox" MinHeight="40" Visibility="Collapsed"
                                             LostKeyboardFocus="ApiKeyControl_OnLostKeyboardFocus" />
                                    <Button Grid.Column="1" Width="72" Margin="8,0,0,0" Content="显示"
                                            x:Name="ToggleApiKeyButton" Click="ToggleApiKeyButton_OnClick" />
                                </Grid>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="模型名" />
                                <Grid Grid.Column="1" Margin="0,5,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ModelCombo" IsEditable="True" MinHeight="40"
                                              LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                    <Button x:Name="FetchModelsButton" Grid.Column="1" Margin="8,0,0,0"
                                            Padding="12,3" Content="拉取可用模型"
                                            Click="FetchModelsButton_OnClick" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="TestProfileButton" DockPanel.Dock="Right" Padding="16,5"
                                        Style="{StaticResource Button.Primary}"
                                        Content="测试" Click="TestProfileButton_OnClick" />
                                <Button x:Name="CopyReportButton" DockPanel.Dock="Right" Margin="0,0,8,0"
                                        Padding="12,5" Content="复制诊断报告" IsEnabled="False"
                                        Click="CopyReportButton_OnClick" />
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"
                                           Text="测试这个档案" />
                            </DockPanel>
                            <TextBlock x:Name="TestStatusText" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="逐项检查配置、网络、鉴权、模型、翻译链路、语音、数据库、快捷键和权限，一眼看出卡在哪一环。" />
                            <ItemsControl x:Name="TestResultsList"
                                          ItemTemplate="{StaticResource DiagnosticItemTemplate}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== 模型参数 ==================== -->
            <ScrollViewer x:Name="ModelParamsSection" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="28,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="模型参数" />
                    <TextBlock x:Name="ModelParamsCaption" Style="{StaticResource SectionCaption}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="请求参数" />
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock VerticalAlignment="Center" Text="Temperature" />
                                <TextBox x:Name="TemperatureBox" Width="64" Margin="8,0,18,0"
                                         LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                <TextBlock VerticalAlignment="Center" Text="最大输出长度" />
                                <TextBox x:Name="MaxTokensBox" Width="82" Margin="8,0,0,0"
                                         LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Temperature 控制回复的随机性：数值越低（如 0），译文越稳定、每次用词都差不多；数值越高（最大 2），用词更多样，但也更容易跑题或前后不一致。翻译场景建议保持默认的 0.2。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="超时（秒）" />
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock VerticalAlignment="Center" Text="整体" />
                                <TextBox x:Name="RequestTimeoutBox" Width="64" Margin="8,0,18,0"
                                         LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                <TextBlock VerticalAlignment="Center" Text="首字" />
                                <TextBox x:Name="FirstTokenTimeoutBox" Width="64" Margin="8,0,10,0"
                                         LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"
                                           Text="首字超时必须小于整体超时" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="超时不会触发自动降级 —— 等满十秒再换一家只会让你等更久。真遇到某家变慢，请到「服务商档案」里手动切换。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="额外请求参数" />
                            <TextBox x:Name="ExtraRequestBodyBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource Font.Mono}"
                                     Margin="0,0,0,3" TextChanged="ExtraRequestBodyBox_OnTextChanged"
                                     LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                            <TextBlock x:Name="ExtraRequestBodyError" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Brush.Danger}" Visibility="Collapsed"
                                       Text="这段不是合法的 JSON，已忽略" />
                            <WrapPanel Margin="0,0,0,8">
                                <Button Margin="0,0,6,4" Padding="8,3" Content="DeepSeek / 智谱：关闭思考"
                                        Tag="deepseek" Click="ExtraPresetButton_OnClick" />
                                <Button Margin="0,0,6,4" Padding="8,3" Content="通义 / 硅基流动：关闭思考"
                                        Tag="qwen" Click="ExtraPresetButton_OnClick" />
                                <Button Margin="0,0,6,4" Padding="8,3" Content="OpenAI：最低推理"
                                        Tag="openai" Click="ExtraPresetButton_OnClick" />
                                <Button Margin="0,0,0,4" Padding="8,3" Content="清空"
                                        Tag="clear" Click="ExtraPresetButton_OnClick" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="大多数模型默认会先『思考』再回答，这让划词翻译又慢又贵。关闭思考的参数各家写法不同，所以它属于档案而不是全局 —— 换档案时会自动带上该服务商的写法。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== 翻译行为 ==================== -->
            <ScrollViewer x:Name="BehaviorSection" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="28,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="翻译行为" />
                    <TextBlock Style="{StaticResource SectionCaption}"
                               Text="翻译模式与语言方向对所有服务商档案通用，切换档案不会改变它们。" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="CurrentModeStatusText" Grid.Row="0" Margin="0,0,0,6" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <ListBox x:Name="ModesList" Grid.Row="1" DisplayMemberPath="Name" MinHeight="200"
                                         SelectionChanged="ModesList_OnSelectionChanged" />
                                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                    <Button x:Name="ApplyModeButton" Style="{StaticResource Button.Primary}"
                                            Padding="12,4" Margin="0,0,6,6" Content="应用" Click="ApplyModeButton_OnClick" />
                                    <Button Padding="12,4" Margin="0,0,6,6" Content="新建" Click="NewModeButton_OnClick" />
                                    <Button x:Name="DeleteModeButton" Padding="12,4" Margin="0,0,6,6"
                                            Content="删除" Click="DeleteModeButton_OnClick" />
                                    <Button x:Name="RestoreModeButton" Padding="12,4" Margin="0,0,0,6"
                                            Content="恢复默认" Click="RestoreModeButton_OnClick" />
                                </WrapPanel>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Margin="0,0,0,5" Text="名称" />
                                <TextBox x:Name="ModeNameBox" Grid.Row="1" Margin="0,0,0,12"
                                         LostKeyboardFocus="ModeNameBox_OnLostKeyboardFocus" />
                                <TextBlock Grid.Row="2" Margin="0,0,0,5" Text="系统提示词" />
                                <TextBox x:Name="ModePromptBox" Grid.Row="3" Margin="0,0,0,8" MinHeight="170"
                                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource Font.Mono}"
                                         LostKeyboardFocus="ModePromptBox_OnLostKeyboardFocus" />
                                <TextBlock Grid.Row="4" Style="{StaticResource Hint}"
                                           Text="可用占位符：{target_lang}  {fallback_lang}。内置模式改乱了可以点「恢复默认」。" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="语言方向与词典" />
                            <WrapPanel Margin="0,0,0,10">
                                <TextBlock VerticalAlignment="Center" Text="目标语言" />
                                <TextBox x:Name="TargetLanguageBox" Width="120" Margin="8,0,18,0"
                                         LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                <TextBlock VerticalAlignment="Center" Text="反向语言" />
                                <TextBox x:Name="FallbackLanguageBox" Width="120" Margin="8,0,0,0"
                                         LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock VerticalAlignment="Center" Text="词典模式词数阈值" />
                                <TextBox x:Name="WordThresholdBox" Width="80" Margin="8,0,0,0"
                                         LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== 触发方式 ==================== -->
            <ScrollViewer x:Name="TriggerSection" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="28,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="触发方式" />
                    <TextBlock Style="{StaticResource SectionCaption}"
                               Text="改完立即生效，不需要重启程序。在下面的测试区可以直接验证。" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="触发键" />
                            <ComboBox x:Name="TriggerKeyCombo" Grid.Row="0" Grid.Column="1" Width="150"
                                      HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                      SelectionChanged="TriggerSetting_OnSelectionChanged">
                                <ComboBoxItem Content="Ctrl" /><ComboBoxItem Content="Shift" /><ComboBoxItem Content="Alt" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="双击间隔（毫秒）" />
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,5,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                                <Slider x:Name="DoubleTapSlider" Minimum="150" Maximum="800" TickFrequency="10"
                                        IsSnapToTickEnabled="True" ValueChanged="DoubleTapSlider_OnValueChanged" />
                                <TextBlock x:Name="DoubleTapValueText" Grid.Column="1" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="单次按键最长时长（毫秒）" />
                            <TextBox x:Name="MaxKeyHoldBox" Grid.Row="2" Grid.Column="1" Width="100"
                                     HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                     LostKeyboardFocus="TriggerTextBox_OnLostKeyboardFocus" />
                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="取词等待时间（毫秒）" />
                            <TextBox x:Name="ClipboardWaitBox" Grid.Row="3" Grid.Column="1" Width="100"
                                     HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                     LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="启用划词" />
                            <CheckBox x:Name="EnabledCheckBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0"
                                      Content="双击触发键后翻译选中文字" Click="GeneralCheckBox_OnClick" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.AccentSubtle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="实时双击测试" />
                            <TextBlock x:Name="DoubleTapTestText" FontSize="{DynamicResource Size.Heading}"
                                       Text="在这里双击触发键试试" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Hint}"
                                       Text="每次有效敲击会显示一个圆点；识别到双击后会显示成功标记。修改触发键或间隔后，测试立即使用新设置。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== 隐私与安全 ==================== -->
            <ScrollViewer x:Name="PrivacySection" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="28,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="隐私与安全" />
                    <TextBlock Style="{StaticResource SectionCaption}"
                               Text="API Key 用 Windows 账户加密保存在本机，明文不落盘，也不会写进日志。" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="应用黑名单" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="RunningProcessesCombo" IsEditable="True" MinHeight="40" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,3" Content="刷新列表"
                                        Click="RefreshProcessesButton_OnClick" />
                                <Button Grid.Column="2" Margin="8,0,0,0" Padding="10,3" Content="添加"
                                        Click="AddBlacklistButton_OnClick" />
                            </Grid>
                            <ListBox x:Name="BlacklistList" Height="140" />
                            <Button Margin="0,8,0,0" Padding="10,3" HorizontalAlignment="Left"
                                    Content="移除选中项" Click="RemoveBlacklistButton_OnClick" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="长文本二次确认阈值" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,5,0,5">
                                <TextBox x:Name="LongTextThresholdBox" Width="100"
                                         LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"
                                           Text="字符，0 表示不确认" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="隐私模式" />
                            <CheckBox x:Name="PrivacyModeCheckBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,8"
                                      Content="翻译时不查询缓存，也不写入历史" Click="GeneralCheckBox_OnClick" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="详细日志" />
                            <CheckBox x:Name="DetailedLoggingCheckBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                      Content="在日志中记录选中的原文（可能包含隐私内容）" Click="GeneralCheckBox_OnClick" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="历史数据" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button Padding="12,4" Margin="0,0,8,0" Content="清空历史记录"
                                        Click="ClearAllHistoryButton_OnClick" />
                                <Button Padding="12,4" Content="清空缓存" Click="ClearCacheButton_OnClick" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="收藏的内容不会被删除。两个按钮都只清除未收藏的记录，你攒下的生词本一条都不会少。若要删除某条收藏，请到主窗口里逐条右键删除。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== 系统 ==================== -->
            <ScrollViewer x:Name="SystemSection" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="28,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="系统" />
                    <TextBlock Style="{StaticResource SectionCaption}"
                               Text="开机自启、浮窗外观和数据文件夹。" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="开机自动启动" />
                            <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Row="0" Grid.Column="1" Margin="0,8,0,8"
                                      Content="登录 Windows 后自动启动 CtrlTranslator"
                                      Click="StartWithWindowsCheckBox_OnClick" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="浮窗字号" />
                            <TextBox x:Name="PopupFontSizeBox" Grid.Row="1" Grid.Column="1" Width="100"
                                     HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                     LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="浮窗最大宽度" />
                            <TextBox x:Name="PopupMaxWidthBox" Grid.Row="2" Grid.Column="1" Width="100"
                                     HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                     LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="浮窗最大高度" />
                            <TextBox x:Name="PopupMaxHeightBox" Grid.Row="3" Grid.Column="1" Width="100"
                                     HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                     LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="流式回退延迟（毫秒）" />
                            <TextBox x:Name="StreamFallbackDelayBox" Grid.Row="4" Grid.Column="1" Width="100"
                                     HorizontalAlignment="Left" Style="{StaticResource FieldBox}"
                                     LostKeyboardFocus="EditableControl_OnLostKeyboardFocus" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="文件夹与导出" />
                            <WrapPanel>
                                <Button Padding="12,4" Margin="0,0,8,0" Content="打开日志文件夹"
                                        Tag="logs" Click="OpenFolderButton_OnClick" />
                                <Button Padding="12,4" Margin="0,0,8,0" Content="打开数据文件夹"
                                        Tag="data" Click="OpenFolderButton_OnClick" />
                                <Button Padding="12,4" Content="导出历史为 CSV…"
                                        Click="ExportHistoryButton_OnClick" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button x:Name="CheckUpdateButton" DockPanel.Dock="Right" Padding="14,5"
                                        Content="检查更新" Click="CheckUpdateButton_OnClick" />
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"
                                           Text="软件更新" />
                            </DockPanel>
                            <CheckBox x:Name="AutoCheckUpdatesCheckBox" Margin="0,0,0,10"
                                      Content="启动后和之后每 24 小时自动检查一次新版本"
                                      Click="GeneralCheckBox_OnClick" />
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.AccentSubtle}">
                        <StackPanel>
                            <TextBlock x:Name="AboutVersionText" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="已知限制：普通权限运行时，无法在管理员权限程序中划词；全局键盘钩子和剪贴板读取也可能被安全软件误报。遇到这些情况，请以管理员身份运行或把程序加入安全软件白名单。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
