<UserControl x:Class="CtrlTranslator.UI.DeepTranslationView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CtrlTranslator.UI"
             Background="{DynamicResource Brush.Transparent}">
    <UserControl.Resources>
        <ui:NonEmptyToVisibleConverter x:Key="NonEmptyToVisible" />

        <!-- ⚠️ 这两个下拉必须用 ItemTemplate，不能图省事写 DisplayMemberPath。
             Themes/Controls.xaml 里的 ComboBox 模板，选中框走的是
             ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"，
             而 SelectionBoxItemTemplate 只跟 ItemTemplate 走、不认 DisplayMemberPath ——
             写成 DisplayMemberPath 的话，展开的列表项是对的，收起来的选中框却显示
             类型全名（"CtrlTranslator.Settings.TranslationMode"）。已踩坑。 -->
        <DataTemplate x:Key="ModeItemTemplate">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="LanguageItemTemplate">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <!-- 例句：第一行是句子本身，第二行是它的中文意思。左边一道竖线把两行框在一起，
             跟浮窗里词典例句的处理保持一致，用户在两个地方看到的是同一种东西。 -->
        <DataTemplate x:Key="ExampleTemplate">
            <Border Margin="0,0,0,14" Padding="12,2,0,2" BorderThickness="2,0,0,0"
                    BorderBrush="{DynamicResource Brush.AccentSecondary}">
                <StackPanel>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding Translation}" TextWrapping="Wrap"
                               FontSize="{DynamicResource Size.BodySmall}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Visibility="{Binding Translation, Converter={StaticResource NonEmptyToVisible}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CollocationTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Note}" TextWrapping="Wrap"
                           FontSize="{DynamicResource Size.BodySmall}"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock FontFamily="{DynamicResource Font.Display}"
                       FontSize="{DynamicResource Size.Heading}" FontWeight="SemiBold"
                       Text="深度翻译" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="粘贴要精读的文字，按 Ctrl+Enter 开始。除了译文还会给例句和常见搭配，比划词慢。划词浮窗不受这里影响。" />
        </StackPanel>

        <!-- 工具条 -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Text="模式"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <ComboBox x:Name="ModeCombo" Width="140" Margin="10,0,0,0"
                          AutomationProperties.Name="翻译模式"
                          ItemTemplate="{StaticResource ModeItemTemplate}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="24,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Text="译成"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <ComboBox x:Name="LanguageCombo" Width="150" Margin="10,0,0,0"
                          AutomationProperties.Name="目标语言"
                          ItemTemplate="{StaticResource LanguageItemTemplate}" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CancelButton" Margin="0,0,10,0" Visibility="Collapsed"
                        Style="{StaticResource Button.Secondary}"
                        Content="停止" Click="CancelButton_OnClick" />
                <Button x:Name="TranslateButton" MinWidth="104"
                        Style="{StaticResource Button.Primary}"
                        Content="翻译" Click="TranslateButton_OnClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="55*" />
            </Grid.ColumnDefinitions>

            <!-- 原文 -->
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Large}"
                    Background="{DynamicResource Brush.Surface}" Padding="20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <TextBlock x:Name="SourceCountText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Size.Caption}"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                        <TextBlock FontSize="{DynamicResource Size.Subheading}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Text="原文" />
                    </DockPanel>

                    <TextBox x:Name="SourceBox" Grid.Row="1" Margin="0,12,0,0"
                             AutomationProperties.Name="待翻译的原文"
                             BorderThickness="0" Padding="0"
                             Background="{DynamicResource Brush.Transparent}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             TextChanged="SourceBox_OnTextChanged"
                             PreviewKeyDown="SourceBox_OnPreviewKeyDown" />
                </Grid>
            </Border>

            <!-- 结果 -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Large}"
                    Background="{DynamicResource Brush.Surface}">
                <Grid>
                    <!-- 空状态 -->
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="320" Margin="28">
                        <Border Width="46" Height="46" HorizontalAlignment="Center" Margin="0,0,0,14"
                                Background="{DynamicResource Brush.SurfaceSubtle}" CornerRadius="23">
                            <Path Width="20" Height="20" Stretch="Uniform" Data="{DynamicResource Icon.Book}"
                                  Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="译文、例句和搭配会显示在这里" />
                        <TextBlock Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="例句和搭配跟着上面选的模式走 —— 学术模式会标句式属于论文哪部分，办公邮件模式会标礼貌级别。" />
                    </StackPanel>

                    <!-- 进行中 -->
                    <StackPanel x:Name="LoadingState" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                            <Path Data="M8,1.25 A6.75,6.75 0 1 1 3.23,3.23"
                                  Stroke="{DynamicResource Brush.Primary}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                 From="0" To="360" Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Viewbox>
                        <TextBlock x:Name="LoadingText" Margin="0,14,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="正在深度翻译… 0.0 秒" />
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center"
                                   FontSize="{DynamicResource Size.Caption}"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   Text="比划词慢是正常的，它要多写例句和搭配。" />
                    </StackPanel>

                    <!-- 出错 -->
                    <StackPanel x:Name="ErrorState" Visibility="Collapsed" MaxWidth="360"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
                        <Path Width="22" Height="22" HorizontalAlignment="Center" Stretch="Uniform"
                              Data="{DynamicResource Icon.Error}"
                              Stroke="{DynamicResource Brush.Danger}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Danger}" />
                    </StackPanel>

                    <!-- 结果 -->
                    <ScrollViewer x:Name="ResultScroller" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="20,18">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="CopyTranslationButton" DockPanel.Dock="Right"
                                        Style="{StaticResource Button.Icon}"
                                        AutomationProperties.Name="复制译文"
                                        ToolTip="复制译文" Click="CopyTranslation_OnClick">
                                    <Path Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource Icon.Copy}"
                                          Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Button>
                                <TextBlock FontSize="{DynamicResource Size.Subheading}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Text="译文" />
                            </DockPanel>
                            <TextBox x:Name="TranslationBox" Margin="0,10,0,0" IsReadOnly="True"
                                     AutomationProperties.Name="译文"
                                     BorderThickness="0" Padding="0"
                                     Background="{DynamicResource Brush.Transparent}"
                                     TextWrapping="Wrap" AcceptsReturn="True" />

                            <StackPanel x:Name="ExamplesSection" Margin="0,26,0,0" Visibility="Collapsed">
                                <TextBlock FontSize="{DynamicResource Size.Subheading}" FontWeight="SemiBold"
                                           Text="例句" />
                                <ItemsControl x:Name="ExamplesList" Margin="0,12,0,0"
                                              ItemTemplate="{StaticResource ExampleTemplate}" />
                            </StackPanel>

                            <StackPanel x:Name="CollocationsSection" Margin="0,14,0,0" Visibility="Collapsed">
                                <TextBlock FontSize="{DynamicResource Size.Subheading}" FontWeight="SemiBold"
                                           Text="常见搭配" />
                                <ItemsControl x:Name="CollocationsList" Margin="0,12,0,0"
                                              ItemTemplate="{StaticResource CollocationTemplate}" />
                            </StackPanel>

                            <TextBlock x:Name="ResultMetaText" Margin="0,18,0,0" TextWrapping="Wrap"
                                       FontSize="{DynamicResource Size.Caption}"
                                       Foreground="{DynamicResource Brush.TextTertiary}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
